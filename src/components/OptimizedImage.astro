---
import type { ImageMetadata } from 'astro';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  sizes?: string;
}

const {
  src,
  alt,
  width = 1200,
  height = 630,
  class: className = '',
  loading = 'lazy',
  sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw'
} = Astro.props;
---

{typeof src === 'string' ? (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    class={className}
    decoding="async"
  />
) : (
  <img
    src={src.src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    class={className}
    decoding="async"
    srcset={src.srcSet?.attribute || ''}
    sizes={sizes}
  />
)}
