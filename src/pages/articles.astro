---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { relativeTime } from '../utils/relativeTime';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const categories = ['Semua', 'Airdrop', 'Tutorial', 'Node'];
---

<BaseLayout title="Semua Catatan - CryptoSynth.id" description="Seluruh catatan crypto personal yang pernah ditulis — airdrop, farming, tutorial, dan opini pasar." terminalPath="~/cryptosynth/articles">
  <div class="terminal-home">
    <div class="term-welcome">
      <h1 class="term-line term-highlight" style="font-size:inherit;font-weight:inherit;margin:0;line-height:inherit">Arsip Semua Catatan</h1>
      <div class="term-line term-dim">Kumpulan catatan personal — airdrop, tutorial, node, dan opini pasar dari sudut pandang pribadi.</div>
      <div class="term-line">&nbsp;</div>
      <div class="term-line">
        <span class="term-dim">  Filter: </span>
        {categories.map((cat, i) => (
          <>
            <a href={cat === 'Semua' ? '/articles' : `/category/${cat.toLowerCase()}`} class="term-accent" style="text-decoration:none; margin-right: 0.5rem;">{cat}</a>
            {i < categories.length - 1 && <span class="term-dim">|</span>}
          </>
        ))}
      </div>
      <div class="term-line">&nbsp;</div>
    </div>

    <div class="term-articles">
      <div class="term-line">&nbsp;</div>
      <div class="term-line">
        <span class="term-dim">  NUM  TAG            TITLE                                              DATE</span>
      </div>
      <div class="term-line">
        <span class="term-dim" style="color:rgba(212,212,212,0.20)">  ───  ───            ─────                                              ────</span>
      </div>
      {posts.map((post, index) => (
        <a href={`/blog/${post.id}`} class="article-entry">
          <div class="entry-meta">
            <span class="entry-date">{new Date(post.data.pubDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', timeZone: 'Asia/Jakarta' })}</span>
            <span class="entry-time">{relativeTime(post.data.pubDate)}</span>
          </div>
          <span class="entry-num">{String(index + 1).padStart(2, '0')}</span>
          <span class="entry-tag">{(post.data.tags || []).slice(0, 2).map((tag) => `#${tag}`).join(' · ')}</span>
          <div class="entry-title">{post.data.title}</div>
          {post.data.excerpt && <div class="entry-excerpt">{post.data.excerpt}</div>}
        </a>
      ))}
      <div class="term-line">&nbsp;</div>
      <div class="term-line term-dim">
        &nbsp;&nbsp;Total: {posts.length} catatan. Tap judul untuk baca.
      </div>
      <div class="term-line">&nbsp;</div>
    </div>
  </div>
</BaseLayout>
