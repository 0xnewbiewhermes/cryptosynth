---
interface Props {
  items: { question: string; answer: string }[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="faq-section">
    <h2 class="faq-title">❓ Pertanyaan yang Sering Diajukan</h2>
    <div class="faq-list">
      {items.map((item, idx) => (
        <details class="faq-item" open={idx === 0}>
          <summary class="faq-question">
            <span>{item.question}</span>
            <svg class="faq-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
)}
