{
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://cryptosynth.id/$1",
      "has": [{ "type": "host", "value": "www.cryptosynth.id" }],
      "permanent": true
    }
  ],
  "trailingSlash": false
}
