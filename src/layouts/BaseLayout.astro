---
import SeoHead from '../components/SeoHead.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishDate?: string;
  modifiedDate?: string;
  author?: string;
  category?: string;
  tags?: string[];
  faq?: string;
  howTo?: { steps: { name: string; text: string }[] };
  itemList?: { name: string; items: { name: string; url?: string; description?: string }[] };
  terminalPath?: string;
}

const { title, description, image, imageAlt, canonical, type = 'website', publishDate, modifiedDate, author, category, tags = [], faq = '', howTo, itemList, terminalPath = '~/cryptosynth' } = Astro.props;

// Active nav state detection
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (path: string) => {
  if (path === '/') return pathname === '/' ? 'active' : '';
  return pathname.startsWith(path) ? 'active' : '';
};
---

<!doctype html>
<html lang="id">
  <head>
    <SeoHead {title} {description} {image} {imageAlt} {canonical} {type} {publishDate} {modifiedDate} {author} {category} {tags} {faq} {howTo} {itemList} />
    <link rel="alternate" type="application/rss+xml" title="CryptoSynth.id RSS" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="mask-icon" href="/favicon.svg?v=3" color="#3b82f6" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0c0c0c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f6f2" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />
    <!-- ↓ Flash prevention: set theme sebelum render -->
    <script is:inline>
      (function() {
        var theme = localStorage.getItem('cryptosynth-theme');
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <!-- Fonts: self-hosted Source Code Pro (no Google Fonts roundtrip) -->
    <link rel="preload" href="/fonts/source-code-pro-400.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/source-code-pro-500.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/source-code-pro-700.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/source-code-pro-900.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <!-- Skip to content -->
    <a href="#main-content" class="skip-link" data-i18n="skip">Langsung ke konten</a>

    <!-- Terminal Topbar -->
    <header class="topbar">
      <div class="topbar-dots">
        <span class="topbar-dot topbar-dot--r"></span>
        <span class="topbar-dot topbar-dot--y"></span>
        <span class="topbar-dot topbar-dot--g"></span>
      </div>
      <span class="topbar-path">{terminalPath}</span>
      <nav class="nav" id="mainNav">
        <a href="/" class={isActive('/')} aria-current={isActive('/') ? 'page' : undefined} data-i18n="nav.notes">Catatan</a>
        <a href="/airdrop" class={isActive('/airdrop')} aria-current={isActive('/airdrop') ? 'page' : undefined} data-i18n="nav.airdrop">Airdrop</a>
        <a href="/articles" class={isActive('/articles')} aria-current={isActive('/articles') ? 'page' : undefined} data-i18n="nav.tutorial">Tutorial</a>
        <a href="/tools" class={isActive('/tools')} aria-current={isActive('/tools') ? 'page' : undefined} data-i18n="nav.tools">Tools</a>
        <a href="/about" class={isActive('/about')} aria-current={isActive('/about') ? 'page' : undefined} data-i18n="nav.about">Tentang</a>
      </nav>
      <div class="topbar-right">
        <button type="button" class="topbar-btn" id="searchToggle" aria-label="Cari catatan" data-i18n-aria="search">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <span data-i18n="searchLabel">Cari</span>
        </button>
        <a href="/rss.xml" class="topbar-btn" aria-label="RSS Feed">RSS</a>
        <button type="button" class="topbar-btn" id="themeToggle" aria-label="Toggle tema">
          <svg class="theme-icon-sun" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="theme-icon-moon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <button type="button" class="topbar-btn lang-toggle" id="langToggle" aria-label="Ganti bahasa"><span id="langToggleLabel">EN</span></button>
        <span class="topbar-clock" id="topbarClock"></span>
        <button type="button" class="menu-toggle" id="menuToggle" aria-label="Toggle menu">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
        </button>
      </div>

      <!-- Search Dropdown -->
      <div class="search-dropdown" id="searchDropdown">
        <div class="search-dropdown-input-wrap">
          <svg class="search-dropdown-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="searchDropdownInput" class="search-dropdown-input" placeholder="grep -i 'keyword' catatan/" autocomplete="off" aria-label="Cari catatan" />
          <button type="button" class="search-dropdown-clear" id="searchDropdownClear" aria-label="Tutup pencarian">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <div id="searchDropdownResults" class="search-dropdown-results" aria-live="polite" role="region" aria-label="Hasil pencarian"></div>
      </div>
    </header>

    <!-- Reading Progress (article pages) -->
    <div class="reading-progress" id="readingProgress"></div>

    <main id="main-content" transition:animate="fade">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-inner">
          <div class="footer-brand">
            <a href="/" class="logo footer-logo">Crypto<span class="logo-accent">Synth</span></a>
            <p>Catatan crypto personal. Node logs, airdrop farming, trading, dan opini dari sudut pandang pribadi.</p>
          </div>
          <div class="footer-links">
            <div class="footer-col">
              <p class="footer-label" data-i18n="footer.explore">Jelajahi</p>
              <a href="/">Catatan</a>
              <a href="/airdrop">Airdrop</a>
              <a href="/articles">Tutorial</a>
              <a href="/tools">Tools</a>
              <a href="/articles">Arsip</a>
            </div>
            <div class="footer-col">
              <p class="footer-label" data-i18n="footer.more">Lainnya</p>
              <a href="/about">Tentang</a>
              <a href="/disclaimer">Disclaimer</a>
              <a href="/privacy">Privacy</a>
            </div>
            <div class="footer-col">
              <p class="footer-label" data-i18n="footer.follow">Ikuti</p>
              <a href="https://twitter.com/cryptosynthid" target="_blank" rel="noopener">X (Twitter)</a>
              <a href="mailto:hello@cryptosynth.id">Email</a>
              <a href="/rss.xml">RSS Feed</a>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>&copy; 2026 CryptoSynth</span>
          <span>catatan pribadi, bukan saran keuangan</span>
        </div>
      </div>
    </footer>

    <!-- Status Bar -->
    <div class="status-bar">
      <span class="status-item"><span class="status-dot"></span> <span data-i18n="status.connected">connected</span></span>
      <span class="status-item" id="statusArticles"></span>
      <span class="status-item" data-i18n="status.categories">3 kategori</span>
      <span class="status-item" id="statusClock"></span>
      <span class="status-item status-version">CryptoSynth.id v2.0</span>
    </div>

    <!-- Scroll to Top -->
    <button type="button" class="scroll-top-btn" id="scrollTopBtn" aria-label="Kembali ke atas">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
    </button>

    <script>
      // === Clock ===
      function updateClock() {
        const now = new Date();
        const time = now.toLocaleTimeString('en-US', { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
        const el1 = document.getElementById('topbarClock');
        const el2 = document.getElementById('statusClock');
        if (el1) el1.textContent = time + ' WIB';
        if (el2) el2.textContent = time + ' WIB';
      }
      updateClock();
      setInterval(updateClock, 1000);

      // === Mobile Menu ===
      const toggle = document.getElementById('menuToggle');
      const nav = document.getElementById('mainNav');
      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          nav.classList.toggle('open');
        });
        nav.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => nav.classList.remove('open'));
        });
        document.addEventListener('click', (e) => {
          if (!nav.contains(e.target) && !toggle.contains(e.target)) {
            nav.classList.remove('open');
          }
        });
      }

      // === Search Dropdown ===
      (function initSearch() {
        var dropdown = document.getElementById('searchDropdown');
        var searchToggle = document.getElementById('searchToggle');
        var input = document.getElementById('searchDropdownInput');
        var results = document.getElementById('searchDropdownResults');
        var clearBtn = document.getElementById('searchDropdownClear');
        var searchIndex: any[] = [];
        var indexLoaded = false;

        function openSearch() {
          dropdown?.classList.add('open');
          document.addEventListener('click', closeOnOutside);
          setTimeout(function() { input?.focus(); }, 80);
          if (!indexLoaded) loadIndex();
        }

        function closeSearch() {
          dropdown?.classList.remove('open');
          document.removeEventListener('click', closeOnOutside);
          if (input) input.value = '';
          if (results) results.innerHTML = '';
        }

        function closeOnOutside(e: Event) {
          if (!dropdown?.contains(e.target as Node) && !searchToggle?.contains(e.target as Node)) {
            closeSearch();
          }
        }

        async function loadIndex() {
          try {
            const resp = await fetch('/api/search-index.json');
            if (resp.ok) {
              searchIndex = await resp.json();
              indexLoaded = true;
            }
          } catch (e) {}
        }

        function doSearch(query: string) {
          if (!results) return;
          if (!query.trim()) { results.innerHTML = ''; results.classList.remove('loading'); return; }
          results.classList.remove('loading');
          const q = query.toLowerCase();
          const hits = searchIndex.filter((item: any) =>
            (item.title || '').toLowerCase().includes(q) ||
            (item.description || '').toLowerCase().includes(q) ||
            (item.tags || []).some((t: string) => t.toLowerCase().includes(q))
          ).slice(0, 8);

          if (hits.length === 0) {
            results.innerHTML = '<div style="padding:0.5rem 0.65rem;font-size:0.78rem;color:var(--text-muted)">Tidak ditemukan: "' + query + '"</div>';
            return;
          }

          results.innerHTML = hits.map((item: any) =>
            '<a href="/blog/' + item.slug + '" class="search-result-item">' +
            '<span class="result-tag">#' + (item.tags?.[0] || 'catatan') + '</span>' +
            '<span class="result-title">' + item.title + '</span></a>'
          ).join('');
        }

        searchToggle?.addEventListener('click', openSearch);
        clearBtn?.addEventListener('click', closeSearch);
        input?.addEventListener('input', function() { doSearch((this as HTMLInputElement).value); });
        input?.addEventListener('keydown', function(e: KeyboardEvent) {
          if (e.key === 'Escape') closeSearch();
        });
      })();

      // === Reading Progress ===
      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        const el = document.getElementById('readingProgress');
        if (el) el.style.width = progress + '%';
      });

      // === Scroll to Top ===
      const scrollTopBtn = document.getElementById('scrollTopBtn');
      if (scrollTopBtn) {
        window.addEventListener('scroll', () => {
          scrollTopBtn.classList.toggle('visible', window.scrollY > 300);
        });
        scrollTopBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // === Status bar article count ===
      const statusArticles = document.getElementById('statusArticles');
      if (statusArticles) {
        const count = document.querySelectorAll('.article-entry').length;
        if (count > 0) {
          statusArticles.textContent = count + ' catatan';
        } else {
          statusArticles.textContent = '13 catatan';
        }
      }

      // === Scroll-Reveal (IntersectionObserver) ===
      if ('IntersectionObserver' in window) {
        var scrollObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              scrollObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.scroll-reveal, .reveal').forEach(function(el) { scrollObserver.observe(el); });
      } else {
        document.querySelectorAll('.scroll-reveal, .reveal').forEach(function(el) { el.classList.add('visible'); });
      }

      // === Search: focus trap when open ===
      (function searchFocus() {
        var sd = document.getElementById('searchDropdown');
        var st = document.getElementById('searchToggle');
        if (!sd || !st) return;
        sd.addEventListener('keydown', function(e) {
          if (e.key !== 'Tab' || !sd.classList.contains('open')) return;
          var focusable = sd.querySelectorAll('input, button, a, [tabindex]:not([tabindex="-1"])');
          if (!focusable.length) return;
          var first = focusable[0];
          var last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        });
      })();

      // === Magnetic buttons ===
      document.querySelectorAll('[data-magnetic]').forEach(function(btn) {
        btn.addEventListener('mousemove', function(e) {
          var rect = btn.getBoundingClientRect();
          var x = (e.clientX - rect.left - rect.width / 2) * 0.2;
          var y = (e.clientY - rect.top - rect.height / 2) * 0.2;
          btn.style.transform = 'translate3d(' + x + 'px, ' + y + 'px, 0)';
        });
        btn.addEventListener('mouseleave', function() {
          btn.style.transform = '';
        });
      });

      // === Button ripple (tracks click position) ===
      document.querySelectorAll('.btn-ripple').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          var rect = btn.getBoundingClientRect();
          var x = ((e.clientX - rect.left) / rect.width * 100).toFixed(1);
          var y = ((e.clientY - rect.top) / rect.height * 100).toFixed(1);
          btn.style.setProperty('--mx', x + '%');
          btn.style.setProperty('--my', y + '%');
          btn.classList.remove('ripple-active');
          void btn.offsetWidth;
          btn.classList.add('ripple-active');
        });
      });

      // === Language Toggle ===
      (function initLanguage() {
        var KEY = 'cryptosynth-language';
        var html = document.documentElement;
        var btn = document.getElementById('langToggle');
        var label = document.getElementById('langToggleLabel');
        var dict = {
          id: {
            skip: 'Langsung ke konten',
            'nav.notes': 'Catatan', 'nav.airdrop': 'Airdrop', 'nav.tutorial': 'Tutorial',
            'nav.tools': 'Tools', 'nav.about': 'Tentang', search: 'Cari catatan', searchLabel: 'Cari',
            'footer.description': 'Catatan crypto personal. Node logs, airdrop farming, trading, dan opini crypto dari sudut pandang pribadi.',
            'footer.explore': 'Jelajahi', 'footer.more': 'Lainnya', 'footer.follow': 'Ikuti',
            'status.connected': 'connected', 'status.categories': '3 kategori'
          },
          en: {
            skip: 'Skip to content',
            'nav.notes': 'Notes', 'nav.airdrop': 'Airdrops', 'nav.tutorial': 'Tutorials',
            'nav.tools': 'Tools', 'nav.about': 'About', search: 'Search notes', searchLabel: 'Search',
            'footer.description': 'Personal crypto notes. Node logs, airdrop farming, trading, and opinions from a practitioner perspective.',
            'footer.explore': 'Explore', 'footer.more': 'More', 'footer.follow': 'Follow',
            'status.connected': 'connected', 'status.categories': '3 categories'
          }
        };
        function apply(lang) {
          var t = dict[lang] || dict.id;
          html.lang = lang;
          html.setAttribute('data-lang', lang);
          document.querySelectorAll('[data-i18n]').forEach(function(el) {
            var key = el.getAttribute('data-i18n');
            if (t[key]) el.textContent = t[key];
          });
          document.querySelectorAll('[data-i18n-aria]').forEach(function(el) {
            var key = el.getAttribute('data-i18n-aria');
            if (t[key]) el.setAttribute('aria-label', t[key]);
          });
          if (label) label.textContent = lang === 'id' ? 'EN' : 'ID';
          if (btn) btn.setAttribute('aria-label', lang === 'id' ? 'Switch to English' : 'Ganti ke Bahasa Indonesia');
          localStorage.setItem(KEY, lang);
        }
        apply(localStorage.getItem(KEY) || 'id');
        if (btn) btn.addEventListener('click', function() {
          apply((html.getAttribute('data-lang') || 'id') === 'id' ? 'en' : 'id');
        });
      })();

      // === Theme Toggle ===
      (function initTheme() {
        var KEY = 'cryptosynth-theme';
        var html = document.documentElement;
        var btn = document.getElementById('themeToggle');
        if (!btn) return;

        function updateMeta(theme) {
          var tc = document.querySelector('meta[name="theme-color"]');
          if (!tc) return;
          tc.removeAttribute('media');
          tc.content = theme === 'dark' ? '#0c0c0c' : '#f8f6f2';
        }

        btn.addEventListener('click', function() {
          var cur = html.getAttribute('data-theme') || 'dark';
          var next = cur === 'dark' ? 'light' : 'dark';

          html.classList.add('theme-transition');
          setTimeout(function() { html.classList.remove('theme-transition'); }, 300);

          html.setAttribute('data-theme', next);
          localStorage.setItem(KEY, next);
          updateMeta(next);
        });
      })();
    </script>
    <script is:inline src="/live-time.js"></script>
</body>
</html>
