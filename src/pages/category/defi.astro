---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { relativeTime } from '../../utils/relativeTime';

const posts = (await getCollection('blog', (p) => p.data.category?.toLowerCase() === 'defi')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<BaseLayout title="DeFi & Token - CryptoSynth.id" description="Analisis protokol DeFi, yield farming, tren token, dan perkembangan decentralized finance terbaru.">
  <div class="page-hero">
    <div class="container">
      <h1>DeFi & Token</h1>
      <p>Analisis protokol DeFi, yield farming, dan tren token terbaru.</p>
    </div>
  </div>
  <section class="section">
    <div class="container">
    <div class="articles-grid">
      {posts.map((post) => (
        <article class="article-card">
          <div class="card-image">
            <img src={`/images/hero/${post.id}.png`} alt={post.data.title} width="1200" height="630" loading="lazy" />
          </div>
          <div class="card-content">
            <div class="card-tags">
              <span class="card-category">{post.data.category || 'DeFi'}</span>
              {(post.data.tags || []).slice(0, 2).map((tag) => (
                <span class="card-tag">#{tag}</span>
              ))}
            </div>
            <h3 class="card-title">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h3>
            <p class="card-excerpt">{post.data.excerpt || post.data.description}</p>
            <div class="card-meta">
              <span class="card-relative-time" data-pubdate={new Date(post.data.pubDate).toISOString()}>{relativeTime(post.data.pubDate)}</span>
              <span class="card-date-sep">·</span>
              <span>{new Date(post.data.pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'Asia/Jakarta' })}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
    {posts.length === 0 && (
      <div style="text-align: center; padding: 4rem 0; color: var(--text-muted);">
        <p>Belum ada artikel di kategori ini.</p>
      </div>
    )}
    </div>
  </section>
</BaseLayout>
