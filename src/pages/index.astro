---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { relativeTime } from '../utils/relativeTime';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

// Trending: most recent 5 for sidebar
const trending = posts.slice(0, 5);

// Stats
const totalArticles = posts.length;
const categories = [...new Set(posts.map(p => p.data.category))].filter(Boolean);
---

<BaseLayout title="CryptoSynth.id - Ringkasan Berita Web3 Setiap Hari">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container hero-layout">
      <!-- Hero Main -->
      <div class="hero-main">
        <div class="hero-badge">
          <span class="hero-badge-dot"></span>
          Updated daily dari sumber kredibel global
        </div>
        <h1>Ringkasan Berita Web3 <br/>Terbaru Setiap Hari</h1>
        <p class="hero-subtitle">TL;DR dari CoinDesk, The Block, dan sumber global lainnya - diringkas khusus untuk pembaca Indonesia.</p>
        <div class="hero-buttons">
          <a href="/berita" class="btn btn-primary">Baca Berita →</a>
          <a href="/about" class="btn btn-pill">Tentang Kami</a>
        </div>
        <!-- Quick Stats -->
        <div class="hero-stats">
          <div class="hero-stat">
            <span class="hero-stat-value">{totalArticles}+</span>
            <span class="hero-stat-label">Artikel</span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-value">{categories.length}</span>
            <span class="hero-stat-label">Kategori</span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-value">Harian</span>
            <span class="hero-stat-label">Update</span>
          </div>
        </div>
      </div>

      <!-- Trending Sidebar -->
      <div class="hero-trending">
        <h3 class="hero-trending-title">Trending Hari Ini</h3>
        <div class="hero-trending-list">
          {trending.map((post, i) => (
            <a href={`/blog/${post.id}`} class="hero-trending-item">
              <h4 class="hero-trending-name">{post.data.title}</h4>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Tools Premium -->
  <section class="section tools-premium">
    <div class="container">
      <div class="tools-premium-grid">
        <a href="/tools" class="tool-premium-card" style="--glow: rgba(41, 66, 212, 0.15)">
          <div class="tpc-glow"></div>
          <div class="tpc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg></div>
          <div class="tpc-body">
            <h4>Airdrop Tracker</h4>
            <p>Risk, sybil, cost & detail lengkap</p>
          </div>
          <span class="tpc-arrow">→</span>
        </a>
        <a href="/scam-check" class="tool-premium-card" style="--glow: rgba(239, 68, 68, 0.15)">
          <div class="tpc-glow"></div>
          <div class="tpc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></div>
          <div class="tpc-body">
            <h4>Scam Checker</h4>
            <p>Cek proyek sebelum invest</p>
          </div>
          <span class="tpc-arrow">→</span>
        </a>
      </div>
    </div>
  </section>
  <!-- Articles Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Berita Terbaru</h2>
        <a href="/articles" class="section-link">Lihat Semua &rarr;</a>
      </div>
      <div class="articles-grid" id="articlesGrid">
        {posts.map((post, index) => (
          <article class:list={['article-card', index >= 9 && 'card-hidden']}>
            <div class="card-image">
              <picture>
                <source srcset={`/images/hero/${post.id}.webp`} type="image/webp" />
                <img src={`/images/hero/${post.id}.png`} alt={post.data.title} width="1200" height="630" loading="lazy" />
              </picture>
            </div>
            <div class="card-content">
              <div class="card-tags">
                <a href={`/category/${post.data.category?.toLowerCase() || 'berita'}`} class="card-category">
                  {post.data.category || 'Berita'}
                </a>
                {(post.data.tags || []).slice(0, 2).map((tag) => (
                  <span class="card-tag">#{tag}</span>
                ))}
              </div>
              <h3 class="card-title">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="card-excerpt">{post.data.excerpt || post.data.description}</p>
              <div class="card-meta">
                <span class="card-relative-time" data-pubdate={new Date(post.data.pubDate).toISOString()}>{relativeTime(post.data.pubDate)}</span>
                <span class="card-date-sep">·</span>
                <span>{new Date(post.data.pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' })}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="articles-more" id="loadMoreWrap" style={posts.length <= 9 ? 'display:none' : ''}>
        <button type="button" class="btn btn-outline articles-more-btn" id="loadMoreBtn">
          Muat Lebih Banyak ↓
        </button>
        <p class="articles-more-count" id="loadMoreCount">Menampilkan 9 dari {posts.length} artikel</p>
      </div>

      {posts.length === 0 && (
        <div style="text-align: center; padding: 4rem 0; color: var(--text-muted);">
          <p style="font-size: 1.1rem; margin-bottom: 0.5rem;">Artikel pertama akan segera hadir</p>
          <p style="font-size: 0.9rem;">Kami sedang menyiapkan konten terbaik untuk Anda.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  (function() {
    var grid = document.getElementById('articlesGrid');
    var btn = document.getElementById('loadMoreBtn');
    var count = document.getElementById('loadMoreCount');
    if (!grid || !btn) return;

    var items = grid.querySelectorAll('.card-hidden');
    var batchSize = 6;
    var shownCount = 9;

    function showBatch() {
      var hidden = grid.querySelectorAll('.card-hidden');
      var toShow = Array.from(hidden).slice(0, batchSize);
      toShow.forEach(function(el) { el.classList.remove('card-hidden'); });
      shownCount += toShow.length;

      if (count) count.textContent = 'Menampilkan ' + shownCount + ' dari ' + items.length + ' artikel';

      if (grid.querySelectorAll('.card-hidden').length === 0) {
        btn.style.display = 'none';
        if (count) count.textContent = 'Semua ' + items.length + ' artikel ditampilkan';
      }
    }

    btn.addEventListener('click', showBatch);
  })();
</script>
