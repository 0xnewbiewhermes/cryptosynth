---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Edit Catatan - Admin CryptoSynth" description="Editor catatan blog">
  <div class="admin-page container">
    <div class="admin-login" id="loginPanel">
      <div class="login-box">
        <h1>🔐 Admin</h1>
        <form id="loginForm">
          <input type="password" id="loginPassword" placeholder="Password" class="adm-input" autocomplete="current-password" />
          <button type="submit" class="adm-btn adm-btn-primary">Login</button>
        </form>
        <p class="login-error" id="loginError"></p>
      </div>
    </div>

    <div class="admin-dashboard" id="dashboard" style="display:none;">
      <div class="adm-header">
        <div>
          <div class="adm-breadcrumb"><a href="/admin">Dashboard</a> / <a href="/admin/articles">Catatan</a> / Edit</div>
          <h1 id="pageTitle">Edit Catatan</h1>
        </div>
        <div class="adm-header-actions">
          <button class="adm-btn adm-btn-success" id="btnSave">💾 Simpan</button>
          <button class="adm-btn adm-btn-outline" id="btnBack">← Kembali</button>
        </div>
      </div>
      <div class="adm-status" id="statusBar"></div>

      <!-- EDITOR -->
      <div class="editor-wrap">
        <div class="editor-toolbar">
          <span class="editor-label">Markdown Content</span>
          <div class="editor-toolbar-actions">
            <button class="adm-btn adm-btn-outline editor-tool" data-insert="bold" title="Bold">B</button>
            <button class="adm-btn adm-btn-outline editor-tool" data-insert="italic" title="Italic"><em>I</em></button>
            <button class="adm-btn adm-btn-outline editor-tool" data-insert="link" title="Link">🔗</button>
            <button class="adm-btn adm-btn-outline editor-tool" data-insert="heading" title="Heading">H2</button>
            <button class="adm-btn adm-btn-outline editor-tool" data-insert="code" title="Code Block">{ }</button>
            <button class="adm-btn adm-btn-outline editor-tool" data-insert="image" title="Image">🖼️</button>
          </div>
        </div>
        <textarea id="editor" class="editor-textarea" spellcheck="false"></textarea>
      </div>

      <!-- PREVIEW -->
      <div class="preview-wrap">
        <div class="editor-toolbar">
          <span class="editor-label">Preview</span>
        </div>
        <div id="preview" class="preview-content"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .admin-page { max-width: 1100px; margin: 0 auto; padding: 2rem 1rem 4rem; }
  .admin-login { display: flex; align-items: center; justify-content: center; min-height: 60vh; }
  .login-box { width: 100%; max-width: 380px; text-align: center; }
  .login-box h1 { font-family: var(--font-display); font-size: 1.75rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-primary); }
  .login-error { color: #dc3545; font-size: 0.85rem; min-height: 1.2em; margin-top: 0.75rem; }

  .adm-input { width: 100%; padding: 0.7rem 0.85rem; border: 1px solid var(--border); border-radius: 0; background: var(--bg-card); color: var(--text-primary); font-size: 0.95rem; font-family: var(--font-body); outline: none; }
  .adm-input:focus { border-color: var(--primary); }
  .adm-btn { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.6rem 1.1rem; border: 1px solid transparent; border-radius: 0; font-size: 0.82rem; font-weight: 600; font-family: var(--font-body); cursor: pointer; transition: all 0.15s; text-decoration: none; white-space: nowrap; }
  .adm-btn-primary { background: var(--primary); color: #fff; border-color: var(--primary); width: 100%; margin-top: 0.75rem; }
  .adm-btn-primary:hover { opacity: 0.9; }
  .adm-btn-success { background: #16a34a; color: #fff; border-color: #16a34a; }
  .adm-btn-success:hover { opacity: 0.9; }
  .adm-btn-outline { background: transparent; color: var(--text-primary); border-color: var(--border); }
  .adm-btn-outline:hover { border-color: var(--text-primary); }

  .adm-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1.25rem; gap: 1rem; flex-wrap: wrap; }
  .adm-header h1 { font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; color: var(--text-primary); margin: 0.15rem 0 0; }
  .adm-header-actions { display: flex; gap: 0.5rem; align-items: center; }
  .adm-breadcrumb { font-size: 0.75rem; color: var(--text-muted); }
  .adm-breadcrumb a { color: var(--primary); text-decoration: none; }
  .adm-breadcrumb a:hover { text-decoration: underline; }
  .adm-status { font-size: 0.82rem; padding: 0.5rem 0; min-height: 1.5em; margin-bottom: 0.75rem; }
  .adm-status.s-success { color: #16a34a; }
  .adm-status.s-error { color: #dc3545; }
  .adm-status.s-info { color: var(--text-muted); }

  /* EDITOR */
  .editor-wrap { margin-bottom: 1.5rem; }
  .editor-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.75rem; border: 1px solid var(--border); border-bottom: none; background: var(--bg); }
  .editor-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); font-weight: 600; }
  .editor-toolbar-actions { display: flex; gap: 0.25rem; }
  .editor-tool { padding: 0.3rem 0.5rem !important; font-size: 0.75rem !important; min-width: 2rem; text-align: center; }

  .editor-textarea {
    width: 100%;
    min-height: 55vh;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--bg-card);
    color: var(--text-primary);
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 0.85rem;
    line-height: 1.6;
    resize: vertical;
    outline: none;
    tab-size: 2;
  }
  .editor-textarea:focus { border-color: var(--primary); }

  /* PREVIEW */
  .preview-wrap { margin-bottom: 2rem; }
  .preview-content {
    border: 1px solid var(--border);
    padding: 1.25rem;
    background: var(--bg-card);
    min-height: 10rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-primary);
    overflow-wrap: break-word;
  }
  .preview-content h1, .preview-content h2, .preview-content h3 { font-family: var(--font-display); margin: 1.25rem 0 0.5rem; }
  .preview-content h1 { font-size: 1.5rem; }
  .preview-content h2 { font-size: 1.25rem; }
  .preview-content h3 { font-size: 1.1rem; }
  .preview-content p { margin: 0.5rem 0; }
  .preview-content pre { background: #1C1812; color: #e8e6e3; padding: 1rem; overflow-x: auto; font-size: 0.8rem; margin: 0.75rem 0; }
  .preview-content code { font-family: 'JetBrains Mono', monospace; font-size: 0.85em; }
  .preview-content :not(pre) > code { background: rgba(0,0,0,0.06); padding: 0.1em 0.3em; }
  .preview-content a { color: var(--primary); }
  .preview-content blockquote { border-left: 3px solid var(--primary); padding-left: 1rem; margin: 0.75rem 0; color: var(--text-muted); }
  .preview-content ul, .preview-content ol { padding-left: 1.5rem; margin: 0.5rem 0; }
  .preview-content img { max-width: 100%; height: auto; }
  .preview-content hr { border: none; border-top: 1px solid var(--border); margin: 1.5rem 0; }

  .preview-content .frontmatter-block {
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.75rem 1rem;
    font-family: monospace;
    font-size: 0.78rem;
    margin-bottom: 1rem;
    white-space: pre-wrap;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .admin-page { padding: 1.5rem 0.75rem 3rem; }
    .adm-header { flex-direction: column; }
    .editor-textarea { min-height: 40vh; }
  }
</style>

<script is:inline>
(function() {
  var TOKEN_KEY = 'cs_admin_token';
  var currentSlug = '';
  var currentSha = '';
  var isNew = false;

  function getToken() { return localStorage.getItem(TOKEN_KEY); }
  function setToken(t) { localStorage.setItem(TOKEN_KEY, t); }
  function clearToken() { localStorage.removeItem(TOKEN_KEY); }

  var loginPanel = document.getElementById('loginPanel');
  var dashboard = document.getElementById('dashboard');
  var loginForm = document.getElementById('loginForm');
  var loginError = document.getElementById('loginError');
  var statusBar = document.getElementById('statusBar');
  var editor = document.getElementById('editor');
  var preview = document.getElementById('preview');
  var pageTitle = document.getElementById('pageTitle');

  // Parse URL params
  var params = new URLSearchParams(window.location.search);
  currentSlug = params.get('slug') || '';
  isNew = params.get('new') === '1';

  function showDashboard() { loginPanel.style.display = 'none'; dashboard.style.display = 'block'; loadPost(); }
  function showLogin() { loginPanel.style.display = 'flex'; dashboard.style.display = 'none'; clearToken(); }
  if (getToken()) showDashboard();

  loginForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    loginError.textContent = '';
    var pw = document.getElementById('loginPassword').value;
    try {
      var res = await fetch('/api/admin/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: pw }) });
      var json = await res.json();
      if (res.ok && json.token) { setToken(json.token); showDashboard(); }
      else { loginError.textContent = json.error || 'Login gagal'; }
    } catch { loginError.textContent = 'Network error'; }
  });

  document.getElementById('btnBack').addEventListener('click', function() { window.location.href = '/admin/articles'; });

  // Load post
  async function loadPost() {
    if (!currentSlug) { status('No slug specified', 'error'); return; }
    pageTitle.textContent = isNew ? 'Catatan Baru: ' + currentSlug : 'Edit: ' + currentSlug;

    if (isNew) {
      var now = new Date();
      var offset = 7 * 60;
      var local = new Date(now.getTime() + offset * 60000);
      var iso = local.toISOString().slice(0, 19).replace('T', 'T') + '+07:00';

      editor.value = '---\ntitle: "' + currentSlug.replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); }) + '"\ncategory: "Airdrop"\ndescription: ""\npubDate: ' + iso + '\nauthor: "Gideon"\ntags:\n  - \nheroImage: "/images/hero/' + currentSlug + '.png"\nogImage: "/images/og/' + currentSlug + '.png"\n---\n\n';
      updatePreview();
      status('Template baru. Isi konten dan simpan.', 'info');
      return;
    }

    status('Loading...', 'info');
    try {
      var res = await fetch('/api/admin/posts?slug=' + encodeURIComponent(currentSlug), { headers: { 'Authorization': 'Bearer ' + getToken() } });
      var json = await res.json();
      if (!res.ok) { if (res.status === 401) { showLogin(); return; } status('Error: ' + json.error, 'error'); return; }
      editor.value = json.content;
      currentSha = json.sha;
      updatePreview();
      status('Loaded: ' + currentSlug, 'success');
    } catch (err) { status('Error: ' + err.message, 'error'); }
  }

  // Save
  document.getElementById('btnSave').addEventListener('click', async function() {
    var content = editor.value;
    if (!content.trim()) { status('Konten kosong!', 'error'); return; }

    var endpoint = '/api/admin/posts';
    var method = isNew ? 'POST' : 'PUT';
    var body = { slug: currentSlug, content: content, message: 'admin: update ' + currentSlug };
    if (!isNew) body.sha = currentSha;

    status('Menyimpan...', 'info');
    try {
      var res = await fetch(endpoint, {
        method: method,
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() },
        body: JSON.stringify(body),
      });
      var json = await res.json();
      if (res.ok && json.success) {
        if (json.newSha) currentSha = json.newSha;
        if (isNew) { isNew = false; pageTitle.textContent = 'Edit: ' + currentSlug; window.history.replaceState(null, '', '/admin/articles/edit?slug=' + encodeURIComponent(currentSlug)); }
        status('✅ ' + json.message, 'success');
      } else {
        if (res.status === 401) { showLogin(); return; }
        status('❌ Error: ' + json.error, 'error');
      }
    } catch (err) { status('❌ Error: ' + err.message, 'error'); }
  });

  // Toolbar
  document.querySelectorAll('.editor-tool').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var type = this.dataset.insert;
      var start = editor.selectionStart;
      var end = editor.selectionEnd;
      var sel = editor.value.substring(start, end);
      var before = editor.value.substring(0, start);
      var after = editor.value.substring(end);
      var insert = '';

      if (type === 'bold') insert = '**' + (sel || 'teks') + '**';
      else if (type === 'italic') insert = '*' + (sel || 'teks') + '*';
      else if (type === 'link') insert = '[' + (sel || 'link text') + '](url)';
      else if (type === 'heading') insert = '\n## ' + (sel || 'Heading');
      else if (type === 'code') insert = '\n```\n' + (sel || 'code') + '\n```\n';
      else if (type === 'image') insert = '![alt](url)';

      editor.value = before + insert + after;
      editor.focus();
      editor.selectionStart = start;
      editor.selectionEnd = start + insert.length;
      updatePreview();
    });
  });

  // Live preview (debounced)
  var previewTimer;
  editor.addEventListener('input', function() {
    clearTimeout(previewTimer);
    previewTimer = setTimeout(updatePreview, 300);
  });

  // Tab support in textarea
  editor.addEventListener('keydown', function(e) {
    if (e.key === 'Tab') {
      e.preventDefault();
      var start = this.selectionStart;
      var end = this.selectionEnd;
      this.value = this.value.substring(0, start) + '  ' + this.value.substring(end);
      this.selectionStart = this.selectionEnd = start + 2;
      updatePreview();
    }
    // Ctrl+S to save
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
      e.preventDefault();
      document.getElementById('btnSave').click();
    }
  });

  function updatePreview() {
    var raw = editor.value;
    // Split frontmatter
    var fmMatch = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
    var fmHtml = '';
    var body = raw;

    if (fmMatch) {
      fmHtml = '<div class="frontmatter-block">' + esc(fmMatch[1]) + '</div>';
      body = fmMatch[2];
    }

    // Simple markdown → HTML
    var html = body
      .replace(/^### (.+)$/gm, '<h3>$1</h3>')
      .replace(/^## (.+)$/gm, '<h2>$1</h2>')
      .replace(/^# (.+)$/gm, '<h1>$1</h1>')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/```(\w*)\n([\s\S]*?)```/g, '<pre><code>$2</code></pre>')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank">$1</a>')
      .replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1" />')
      .replace(/^> (.+)$/gm, '<blockquote>$1</blockquote>')
      .replace(/^---$/gm, '<hr>')
      .replace(/^- (.+)$/gm, '<li>$1</li>')
      .replace(/\n\n/g, '</p><p>')
      .replace(/\n/g, '<br>');

    // Wrap loose <li> in <ul>
    html = html.replace(/(<li>.*<\/li>)/gs, '<ul>$1</ul>');
    // Clean up double wrapping
    html = html.replace(/<\/ul>\s*<ul>/g, '');

    preview.innerHTML = fmHtml + '<p>' + html + '</p>';
  }

  function status(msg, type) { statusBar.textContent = msg; statusBar.className = 'adm-status s-' + type; }
  function esc(s) { if (!s) return ''; return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
})();
</script>
