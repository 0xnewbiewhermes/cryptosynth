---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { relativeTime } from '../../utils/relativeTime';

const posts = (await getCollection('blog', (p) => p.data.category?.toLowerCase() === 'node')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<BaseLayout title="Node - CryptoSynth.id" description="Catatan operasi node, uptime, dan pengalaman menjalankan berbagai node crypto." terminalPath="~/cryptosynth/category/node">
  <div class="terminal-home">
    <div class="term-welcome">
      <div class="term-line term-highlight">Kategori: Node</div>
      <div class="term-line term-dim">Catatan operasi node, uptime, dan pengalaman menjalankan berbagai node crypto.</div>
      <div class="term-line">&nbsp;</div>
    </div>

    <div class="term-articles">
      {posts.length === 0 ? (
        <div class="term-line term-dim">&nbsp;&nbsp;Belum ada catatan di kategori ini.</div>
      ) : (
        <>
          <div class="term-line">&nbsp;</div>
          <div class="term-line">
            <span class="term-dim">  NUM  TAG            TITLE                                              DATE</span>
          </div>
          <div class="term-line">
            <span class="term-dim" style="color:rgba(212,212,212,0.08)">  ───  ───            ─────                                              ────</span>
          </div>
          {posts.map((post, index) => (
            <a href={`/blog/${post.id}`} class="article-entry">
              <div class="entry-meta">
                <span class="entry-date">{new Date(post.data.pubDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', timeZone: 'Asia/Jakarta' })}</span>
                <span class="entry-time">{relativeTime(post.data.pubDate)}</span>
              </div>
              <span class="entry-num">{String(index + 1).padStart(2, '0')}</span>
              <span class="entry-tag">{(post.data.tags || []).slice(0, 2).map((tag) => `#${tag}`).join(' · ')}</span>
              <div class="entry-title">{post.data.title}</div>
              {post.data.excerpt && <div class="entry-excerpt">{post.data.excerpt}</div>}
            </a>
          ))}
          <div class="term-line">&nbsp;</div>
          <div class="term-line term-dim">
            &nbsp;&nbsp;Total: {posts.length} catatan node. Tap judul untuk baca.
          </div>
          <div class="term-line">&nbsp;</div>
        </>
      )}
    </div>
  </div>
</BaseLayout>
