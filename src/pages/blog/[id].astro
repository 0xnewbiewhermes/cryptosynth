---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Parse FAQ from raw content (content collection may not pass nested arrays)
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

let faqItems: { question: string; answer: string }[] = [];
try {
  const __dirname = path.dirname(fileURLToPath(import.meta.url));
  const rawPath = path.join(__dirname, '../../content/blog', `${post.id}.md`);
  const raw = fs.readFileSync(rawPath, 'utf-8');
  const fmMatch = raw.match(/^---\n([\s\S]*?)\n---/);
  if (fmMatch) {
    const fm = fmMatch[1];
    const items = fm.match(/- question:\s*"([^"]+?)"\n\s+answer:\s*"([^"]+?)"/g);
    if (items) {
      faqItems = items.map((item) => {
        const q = item.match(/question:\s*"([^"]+?)"/)?.[1] || '';
        const a = item.match(/answer:\s*"([^"]+?)"/)?.[1] || '';
        return { question: q, answer: a };
      });
    }
  }
} catch (e) {
  faqItems = post.data.faq || [];
}

const formattedDate = new Date(post.data.pubDate).toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Asia/Jakarta',
});

// Date with WIB timezone offset for structured data
function toWIB(date: Date): string {
  const wib = new Date(date.getTime() + 7 * 60 * 60 * 1000);
  return wib.toISOString().replace('Z', '+07:00');
}
const publishDateWIB = post.data.pubDate ? toWIB(new Date(post.data.pubDate)) : undefined;
const modifiedDateWIB = post.data.updatedDate ? toWIB(new Date(post.data.updatedDate)) : publishDateWIB;

// OG image path
const ogImage = `/images/og/${post.id}.png`;
// Hero image path
const heroImage = `/images/hero/${post.id}.png`;

// Related articles: score by shared tags + same category, pick top 3
const allPosts = await getCollection('blog');
const currentTags = new Set(post.data.tags || []);
const currentCategory = post.data.category;
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => {
    const sharedTags = (p.data.tags || []).filter((t) => currentTags.has(t)).length;
    const sameCategory = p.data.category === currentCategory ? 1 : 0;
    return { post: p, score: sharedTags * 2 + sameCategory };
  })
  .sort((a, b) => b.score - a.score || new Date(b.post.data.pubDate).getTime() - new Date(a.post.data.pubDate).getTime())
  .slice(0, 3)
  .map((r) => r.post);

// Popular articles for sidebar (most recent 5, excluding current)
const popularPosts = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 5);

const shareUrl = `https://cryptosynth.id/blog/${post.id}`;
const shareText = post.data.title;
---

<BaseLayout title={post.data.title} description={post.data.excerpt || post.data.description} image={ogImage} type="article" publishDate={publishDateWIB} modifiedDate={modifiedDateWIB} category={post.data.category} tags={post.data.tags} faq={faqItems}>
  <article class="article-page">
    <!-- Article Header -->
    <div class="article-header">
      <div class="container">
        <div class="article-hero">
          <img src={heroImage} alt={post.data.title} loading="lazy" />
        </div>
        <a href={`/category/${post.data.category?.toLowerCase() || 'berita'}`} class="card-category">
          {post.data.category || 'Berita'}
        </a>
        <h1>{post.data.title}</h1>
        <div class="article-meta">
          <span class="meta-author">CryptoSynth Research</span>
          <span class="meta-sep">·</span>
          <span>{formattedDate}</span>
        </div>
      </div>
    </div>

    <!-- Two-Column Layout -->
    <div class="article-layout container">
      <!-- Main Content -->
      <div class="article-main">
        <div class="article-body">
          <Content />
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          )}
        </div>

        <!-- Share Section -->
        <div class="share-section">
          <span class="share-label">Bagikan Artikel Ini</span>
          <div class="share-buttons">
            <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText + ' ' + shareUrl)}`} target="_blank" rel="noopener noreferrer" class="share-btn share-whatsapp" title="WhatsApp">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              <span>WhatsApp</span>
            </a>
            <a href={`https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareText)}`} target="_blank" rel="noopener noreferrer" class="share-btn share-telegram" title="Telegram">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
              <span>Telegram</span>
            </a>
            <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer" class="share-btn share-x" title="X (Twitter)">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              <span>X</span>
            </a>
          </div>
        </div>

        <!-- FAQ Section -->
        <FaqSection items={faqItems} />

        <!-- Related Articles -->
        {relatedPosts.length > 0 && (
          <aside class="related-articles">
            <h2 class="related-articles-title">Artikel Terkait</h2>
            <div class="related-articles-grid">
              {relatedPosts.map((rp) => (
                <a href={`/blog/${rp.id}`} class="related-article-card">
                  <img src={`/images/hero/${rp.id}.png`} alt={rp.data.title} class="related-article-img" loading="lazy" />
                  <div class="related-article-content">
                    <span class="related-article-category">{rp.data.category || 'Berita'}</span>
                    <h3 class="related-article-title">{rp.data.title}</h3>
                  </div>
                </a>
              ))}
            </div>
          </aside>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="article-sidebar">
        <!-- Popular Articles -->
        <div class="sidebar-section">
          <h3 class="sidebar-title">Berita Populer</h3>
          <div class="sidebar-articles">
            {popularPosts.map((pop, i) => (
              <a href={`/blog/${pop.id}`} class="sidebar-article">
                <span class="sidebar-article-num">{i + 1}</span>
                <div class="sidebar-article-info">
                  <span class="sidebar-article-cat">{pop.data.category || 'Berita'}</span>
                  <h4 class="sidebar-article-title">{pop.data.title}</h4>
                  <span class="sidebar-article-date">
                    {new Date(pop.data.pubDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', timeZone: 'Asia/Jakarta' })}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Newsletter CTA -->
        <div class="sidebar-section sidebar-newsletter">
          <h3 class="sidebar-title">Newsletter</h3>
          <p class="sidebar-newsletter-text">Dapatkan ringkasan berita web3 langsung di inbox kamu setiap hari.</p>
          <a href="https://t.me/cryptosynthid" target="_blank" rel="noopener noreferrer" class="sidebar-newsletter-btn">
            Join Telegram Channel
          </a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
