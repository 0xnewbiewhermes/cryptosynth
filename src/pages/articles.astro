---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { relativeTime } from '../utils/relativeTime';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const categories = ['Semua', 'Airdrop', 'Tutorial'];
---

<BaseLayout title="Semua Catatan - CryptoSynth.id" description="Seluruh catatan crypto personal yang pernah ditulis — airdrop, farming, tutorial, dan opini pasar.">
  <section class="hero-v3">
    <div class="container">
      <div class="hero-v3-label">✦ Arsip</div>
      <h1>Semua Catatan</h1>
      <p class="hero-v3-subtitle">Kumpulan catatan personal — airdrop, tutorial, node, dan opini pasar dari sudut pandang pribadi.</p>
    </div>
  </section>

  <div class="section-divider"></div>

  <section class="section-articles">
    <div class="container">
      <div class="category-filter">
        {categories.map((cat) => (
          <a
            href={cat === 'Semua' ? '/articles' : `/category/${cat.toLowerCase()}`}
            class:list={['filter-link', cat === 'Semua' && 'filter-link-active']}
          >
            {cat}
          </a>
        ))}
      </div>

      <div class="article-rows">
        {posts.map((post) => (
          <article class="article-row">
            <div class="article-row-left">
              <div class="article-row-tags">
                {(post.data.tags || []).slice(0, 2).map((tag) => (
                  <span class="article-row-tag">#{tag}</span>
                ))}
              </div>
              <h3 class="article-row-title">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="article-row-excerpt">{post.data.excerpt || post.data.description}</p>
            </div>
            <div class="article-row-right">
              <span class="article-row-time" data-pubdate={new Date(post.data.pubDate).toISOString()}>{relativeTime(post.data.pubDate)}</span>
              <span class="article-row-date">{new Date(post.data.pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' })}</span>
            </div>
          </article>
        ))}
      </div>

      {posts.length === 0 && (
        <div style="text-align: center; padding: 4rem 0; color: var(--text-muted);">
          <p>Belum ada catatan yang dipublikasikan.</p>
        </div>
      )}

      <div style="text-align: center; padding: 2rem 0 0; color: var(--text-muted); font-size: 0.75rem;">
        Menampilkan {posts.length} catatan
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .category-filter {
    display: flex;
    gap: 0;
    margin-bottom: 1.5rem;
  }
  .filter-link {
    padding: 0.45rem 1.25rem;
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
    color: var(--text-muted);
    position: relative;
  }
  .filter-link-active {
    color: var(--text-primary);
  }
  .filter-link-active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 1.25rem;
    right: 1.25rem;
    height: 1.5px;
    background: var(--text-primary);
  }
</style>
