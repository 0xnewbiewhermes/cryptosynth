# CryptoSynth Environment Variables
# Copy this file to .env and fill in your API keys.
# All keys are OPTIONAL — the scam checker gracefully skips missing sources.

# VirusTotal API — malware/phishing domain scanning
# Get yours: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Google Safe Browsing API — safe browsing threat detection
# Get yours: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_KEY=

# URLScan.io API — URL scanning and screenshot analysis
# Get yours: https://urlscan.io/user/apikeys/
URLSCAN_API_KEY=

# URLhaus API — malware URL database
# Get yours: https://urlhaus-api.abuse.ch/
URLHAUS_AUTH_KEY=
