---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Edit Page - Admin CryptoSynth" description="Editor halaman situs">
  <div class="admin-page container">
    <div class="admin-login" id="loginPanel">
      <div class="login-box">
        <h1>🔐 Admin</h1>
        <form id="loginForm">
          <input type="password" id="loginPassword" placeholder="Password" class="adm-input" autocomplete="current-password" />
          <button type="submit" class="adm-btn adm-btn-primary">Login</button>
        </form>
        <p class="login-error" id="loginError"></p>
      </div>
    </div>

    <div class="admin-dashboard" id="dashboard" style="display:none;">
      <div class="adm-header">
        <div>
          <div class="adm-breadcrumb"><a href="/admin">Dashboard</a> / <a href="/admin/pages">Pages</a> / Edit</div>
          <h1 id="pageTitle">Edit Page</h1>
        </div>
        <div class="adm-header-actions">
          <button class="adm-btn adm-btn-success" id="btnSave">💾 Simpan</button>
          <button class="adm-btn adm-btn-outline" id="btnBack">← Kembali</button>
        </div>
      </div>
      <div class="adm-status" id="statusBar"></div>

      <div class="editor-wrap">
        <div class="editor-toolbar">
          <span class="editor-label">Source Code (.astro / .ts)</span>
          <span class="editor-path" id="filePath"></span>
        </div>
        <textarea id="editor" class="editor-textarea" spellcheck="false"></textarea>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .admin-page { max-width: 1100px; margin: 0 auto; padding: 2rem 1rem 4rem; }
  .admin-login { display: flex; align-items: center; justify-content: center; min-height: 60vh; }
  .login-box { width: 100%; max-width: 380px; text-align: center; }
  .login-box h1 { font-family: var(--font-display); font-size: 1.75rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-primary); }
  .login-error { color: #dc3545; font-size: 0.85rem; min-height: 1.2em; margin-top: 0.75rem; }

  .adm-input { width: 100%; padding: 0.7rem 0.85rem; border: 1px solid var(--border); border-radius: 0; background: var(--bg-card); color: var(--text-primary); font-size: 0.95rem; font-family: var(--font-body); outline: none; }
  .adm-input:focus { border-color: var(--primary); }
  .adm-btn { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.6rem 1.1rem; border: 1px solid transparent; border-radius: 0; font-size: 0.82rem; font-weight: 600; font-family: var(--font-body); cursor: pointer; transition: all 0.15s; text-decoration: none; white-space: nowrap; }
  .adm-btn-primary { background: var(--primary); color: #fff; border-color: var(--primary); width: 100%; margin-top: 0.75rem; }
  .adm-btn-primary:hover { opacity: 0.9; }
  .adm-btn-success { background: #16a34a; color: #fff; border-color: #16a34a; }
  .adm-btn-success:hover { opacity: 0.9; }
  .adm-btn-outline { background: transparent; color: var(--text-primary); border-color: var(--border); }
  .adm-btn-outline:hover { border-color: var(--text-primary); }

  .adm-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 1.25rem; gap: 1rem; flex-wrap: wrap; }
  .adm-header h1 { font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; color: var(--text-primary); margin: 0.15rem 0 0; }
  .adm-header-actions { display: flex; gap: 0.5rem; align-items: center; }
  .adm-breadcrumb { font-size: 0.75rem; color: var(--text-muted); }
  .adm-breadcrumb a { color: var(--primary); text-decoration: none; }
  .adm-breadcrumb a:hover { text-decoration: underline; }
  .adm-status { font-size: 0.82rem; padding: 0.5rem 0; min-height: 1.5em; margin-bottom: 0.75rem; }
  .adm-status.s-success { color: #16a34a; }
  .adm-status.s-error { color: #dc3545; }
  .adm-status.s-info { color: var(--text-muted); }

  .editor-wrap { margin-bottom: 2rem; }
  .editor-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.75rem; border: 1px solid var(--border); border-bottom: none; background: var(--bg); }
  .editor-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); font-weight: 600; }
  .editor-path { font-size: 0.72rem; font-family: monospace; color: var(--text-muted); }

  .editor-textarea {
    width: 100%;
    min-height: 70vh;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--bg-card);
    color: var(--text-primary);
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 0.82rem;
    line-height: 1.6;
    resize: vertical;
    outline: none;
    tab-size: 2;
  }
  .editor-textarea:focus { border-color: var(--primary); }

  @media (max-width: 768px) {
    .admin-page { padding: 1.5rem 0.75rem 3rem; }
    .adm-header { flex-direction: column; }
    .editor-textarea { min-height: 50vh; }
  }
</style>

<script is:inline>
(function() {
  var TOKEN_KEY = 'cs_admin_token';
  var currentSlug = '';
  var currentPath = '';
  var currentSha = '';

  function getToken() { return localStorage.getItem(TOKEN_KEY); }
  function setToken(t) { localStorage.setItem(TOKEN_KEY, t); }
  function clearToken() { localStorage.removeItem(TOKEN_KEY); }

  var loginPanel = document.getElementById('loginPanel');
  var dashboard = document.getElementById('dashboard');
  var loginForm = document.getElementById('loginForm');
  var loginError = document.getElementById('loginError');
  var statusBar = document.getElementById('statusBar');
  var editor = document.getElementById('editor');
  var pageTitle = document.getElementById('pageTitle');
  var filePath = document.getElementById('filePath');

  var params = new URLSearchParams(window.location.search);
  currentSlug = params.get('slug') || '';

  function showDashboard() { loginPanel.style.display = 'none'; dashboard.style.display = 'block'; loadPage(); }
  function showLogin() { loginPanel.style.display = 'flex'; dashboard.style.display = 'none'; clearToken(); }
  if (getToken()) showDashboard();

  loginForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    loginError.textContent = '';
    var pw = document.getElementById('loginPassword').value;
    try {
      var res = await fetch('/api/admin/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: pw }) });
      var json = await res.json();
      if (res.ok && json.token) { setToken(json.token); showDashboard(); }
      else { loginError.textContent = json.error || 'Login gagal'; }
    } catch { loginError.textContent = 'Network error'; }
  });

  document.getElementById('btnBack').addEventListener('click', function() { window.location.href = '/admin/pages'; });

  async function loadPage() {
    if (!currentSlug) { status('No slug', 'error'); return; }
    pageTitle.textContent = 'Edit: ' + currentSlug;
    status('Loading...', 'info');
    try {
      var res = await fetch('/api/admin/pages?slug=' + encodeURIComponent(currentSlug), { headers: { 'Authorization': 'Bearer ' + getToken() } });
      var json = await res.json();
      if (!res.ok) { if (res.status === 401) { showLogin(); return; } status('Error: ' + json.error, 'error'); return; }
      editor.value = json.content;
      currentSha = json.sha;
      currentPath = json.path;
      filePath.textContent = json.path;
      pageTitle.textContent = 'Edit: ' + json.label;
      status('Loaded: ' + json.label, 'success');
    } catch (err) { status('Error: ' + err.message, 'error'); }
  }

  document.getElementById('btnSave').addEventListener('click', async function() {
    var content = editor.value;
    if (!content.trim()) { status('Konten kosong!', 'error'); return; }
    status('Menyimpan...', 'info');
    try {
      var res = await fetch('/api/admin/pages', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() },
        body: JSON.stringify({ slug: currentSlug, content: content, sha: currentSha, message: 'admin: update ' + currentSlug }),
      });
      var json = await res.json();
      if (res.ok && json.success) {
        if (json.newSha) currentSha = json.newSha;
        status('✅ ' + json.message, 'success');
      } else {
        if (res.status === 401) { showLogin(); return; }
        status('❌ Error: ' + json.error, 'error');
      }
    } catch (err) { status('❌ Error: ' + err.message, 'error'); }
  });

  // Tab + Ctrl+S
  editor.addEventListener('keydown', function(e) {
    if (e.key === 'Tab') {
      e.preventDefault();
      var start = this.selectionStart;
      var end = this.selectionEnd;
      this.value = this.value.substring(0, start) + '  ' + this.value.substring(end);
      this.selectionStart = this.selectionEnd = start + 2;
    }
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
      e.preventDefault();
      document.getElementById('btnSave').click();
    }
  });

  function status(msg, type) { statusBar.textContent = msg; statusBar.className = 'adm-status s-' + type; }
})();
</script>
