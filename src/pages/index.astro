---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { relativeTime } from '../utils/relativeTime';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<BaseLayout title="Web3 Insights Daily">
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        Updated daily dari sumber kredibel global
      </div>
      <h1>
        <span class="gradient-text">Web3 Insights</span><br/>Daily
      </h1>
      <p>Berita crypto, airdrop, DeFi, dan analisis harian &mdash; diringkas khusus untuk pembaca Indonesia.</p>
      <div class="hero-buttons">
        <a href="/category/berita" class="btn btn-primary">Baca Berita &rarr;</a>
        <a href="/about" class="btn btn-outline">Tentang Kami</a>
      </div>
    </div>
  </section>

  <!-- Articles -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Artikel Terbaru</h2>
        <p>Ringkasan harian dari CoinDesk, The Block, Decrypt, dan sumber terpercaya lainnya.</p>
      </div>
      <div class="articles-grid">
        {posts.slice(0, 9).map((post) => (
          <article class="article-card">
            <div class="card-content">
              <a href={`/category/${post.data.category?.toLowerCase() || 'berita'}`} class="card-category">
                {post.data.category || 'Berita'}
              </a>
              <h3 class="card-title">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="card-excerpt">{post.data.excerpt || post.data.description}</p>
              <div class="card-meta">
                <span class="card-relative-time" data-pubdate={new Date(post.data.pubDate).toISOString()}>{relativeTime(post.data.pubDate)}</span>
                <span class="card-date-sep">·</span>
                <span>{new Date(post.data.pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      {posts.length > 9 && (
        <div style="text-align: center; padding: 2rem 0 1rem;">
          <a href="/articles" class="btn btn-outline" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 2rem; font-size: 0.95rem;">
            Berita Selengkapnya &rarr;
          </a>
        </div>
      )}

      {posts.length === 0 && (
        <div style="text-align: center; padding: 4rem 0; color: var(--text-muted);">
          <p style="font-size: 1.1rem; margin-bottom: 0.5rem;">Artikel pertama akan segera hadir</p>
          <p style="font-size: 0.9rem;">Kami sedang menyiapkan konten terbaik untuk Anda.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
