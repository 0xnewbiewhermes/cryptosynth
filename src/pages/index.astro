---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { relativeTime } from '../utils/relativeTime';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

// Trending: most recent 5
const trending = posts.slice(0, 5);

---

<BaseLayout title="CryptoSynth — Catatan Crypto dari Kalimantan" description="CryptoSynth — catatan crypto pribadi dari Kalimantan. Node logs, portfolio tracker, opini DeFi, dan farming airdrop.">
  <!-- Hero -->
  <section class="hero-v2">
    <div class="container hero-v2-layout">
      <div class="hero-v2-text">
        <div class="hero-v2-badge">✦ Hanya catatan</div>
        <h1>Catatan Crypto Personal</h1>
        <p class="hero-v2-subtitle">Catatan dari seseorang yang setiap hari ngurusin node, farming airdrop, trading, dan opini crypto dari sudut pandang pribadi.</p>
      </div>
    </div>
  </section>

  <!-- Trending -->
  <section class="trending-v2">
    <div class="container">
      <div class="trending-v2-label">🔥TRENDING</div>
      <div class="trending-v2-list">
        {trending.map((post, i) => (
          <a href={`/blog/${post.id}`} class="trending-v2-item">
            <span class="trending-v2-rank">#{i + 1}</span>
            <span class="trending-v2-title">{post.data.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Articles -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Semua Catatan</h2>
        <a href="/articles" class="section-link">Lihat Semua &rarr;</a>
      </div>
      <div class="articles-grid" id="articlesGrid">
        {posts.map((post, index) => (
          <article class:list={['card-v2', index >= 9 && 'card-v2-hidden']}>
            <div class="card-v2-body">
              <div class="card-v2-tags">
                {(post.data.tags || []).slice(0, 2).map((tag) => (
                  <span class="card-v2-tag">#{tag}</span>
                ))}
              </div>
              <h3 class="card-v2-title">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="card-v2-excerpt">{post.data.excerpt || post.data.description}</p>
              <div class="card-v2-meta">
                <span data-live-time data-pubdate={new Date(post.data.pubDate).toISOString()}>{relativeTime(post.data.pubDate)}</span>
                <span class="card-v2-sep">·</span>
                <span>{new Date(post.data.pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' })}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="articles-more" id="loadMoreWrap" style={posts.length <= 9 ? 'display:none' : ''}>
        <button type="button" class="btn btn-outline articles-more-btn" id="loadMoreBtn">
          Muat Lagi ↓
        </button>
        <p class="articles-more-count" id="loadMoreCount">Menampilkan 9 dari {posts.length} artikel</p>
      </div>

      {posts.length === 0 && (
        <div style="text-align: center; padding: 4rem 0; color: var(--text-muted);">
          <p style="font-size: 1.1rem; margin-bottom: 0.5rem;">Artikel pertama akan segera hadir</p>
          <p style="font-size: 0.9rem;">Kami sedang menyiapkan konten terbaik untuk Anda.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== HERO V2 ===== */
  .hero-v2 {
    padding: 1.5rem 0 1.25rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .hero-v2-badge {
    font-size: 0.8rem;
    color: var(--primary);
    font-weight: 500;
    margin-bottom: 0.4rem;
    letter-spacing: 0.02em;
  }

  .hero-v2-text h1 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    max-width: 520px;
  }

  .hero-v2-subtitle {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
    max-width: 420px;
  }

  /* ===== TRENDING V2 ===== */
  .trending-v2 {
    padding: 1.25rem 0;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
  }

  .trending-v2-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 0.7rem;
  }

  .trending-v2-list {
    display: flex;
    gap: 0.65rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .trending-v2-list::-webkit-scrollbar {
    display: none;
  }

  .trending-v2-item {
    flex-shrink: 0;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.6rem 1rem;
    max-width: 240px;
    text-decoration: none;
    transition: box-shadow 0.15s, border-color 0.15s;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .trending-v2-item:hover {
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    border-color: var(--text-muted);
  }

  .trending-v2-rank {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--primary);
    letter-spacing: 0.03em;
  }

  .trending-v2-title {
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--text-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .trending-v2-item {
      max-width: 200px;
      padding: 0.5rem 0.8rem;
    }
    .trending-v2-title {
      font-size: 0.73rem;
    }
  }

  /* ===== CARD V2 — No Images ===== */
  .card-v2 {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: box-shadow 0.2s, border-color 0.2s;
    display: flex;
    flex-direction: column;
  }

  .card-v2:hover {
    box-shadow: 0 4px 16px rgba(28, 24, 18, 0.05);
    border-color: var(--text-muted);
  }

  .card-v2-body {
    padding: 0.9rem 1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .card-v2-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .card-v2-cat {
    display: inline-block;
    font-size: 0.68rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(30, 64, 175, 0.08);
    color: var(--primary);
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: background 0.15s;
  }

  .card-v2-cat:hover {
    opacity: 1;
    background: rgba(30, 64, 175, 0.14);
  }

  .card-v2-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .card-v2-tag {
    font-size: 0.6rem;
    color: var(--text-muted);
  }

  .card-v2-title {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  .card-v2-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .card-v2-title a:hover {
    opacity: 1;
    color: var(--primary);
  }

  .card-v2-excerpt {
    font-size: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.4;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-v2-meta {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.65rem;
    color: var(--text-muted);
    margin-top: auto;
    padding-top: 0.3rem;
  }

  [data-live-time] {
    color: var(--text-muted);
  }

  .card-v2-sep {
    color: var(--border);
  }

  .card-v2-hidden {
    display: none;
  }

  /* Override section-header for cleaner spacing */
  .section-header {
    margin-bottom: 1.25rem;
  }
</style>

<script>
  (function() {
    var grid = document.getElementById('articlesGrid');
    var btn = document.getElementById('loadMoreBtn');
    var count = document.getElementById('loadMoreCount');
    if (!grid || !btn) return;

    var items = grid.querySelectorAll('.card-v2-hidden');
    var batchSize = 6;
    var shownCount = 9;

    function showBatch() {
      var hidden = grid.querySelectorAll('.card-v2-hidden');
      var toShow = Array.from(hidden).slice(0, batchSize);
      toShow.forEach(function(el) { el.classList.remove('card-v2-hidden'); });
      shownCount += toShow.length;

      if (count) count.textContent = 'Menampilkan ' + shownCount + ' dari ' + items.length + ' artikel';

      if (grid.querySelectorAll('.card-v2-hidden').length === 0) {
        btn.style.display = 'none';
        if (count) count.textContent = 'Semua ' + items.length + ' artikel ditampilkan';
      }
    }

    btn.addEventListener('click', showBatch);
  })();
</script>
<!-- live-time moved to BaseLayout.astro -->
