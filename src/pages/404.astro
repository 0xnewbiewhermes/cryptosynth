---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Halaman Tidak Ditemukan — CryptoSynth.id" description="Halaman yang kamu cari tidak ditemukan. Kembali ke beranda CryptoSynth.id.">
  <section class="error-page">
    <div class="container">
      <div class="error-content">
        <div class="error-code">404</div>
        <h1>Halaman Tidak Ditemukan</h1>
        <p>Halaman yang kamu cari sudah dipindahkan, dihapus, atau tidak pernah ada.</p>
        <div class="error-actions">
          <a href="/" class="btn btn-primary">Kembali ke Beranda &rarr;</a>
          <a href="/category/berita" class="btn btn-outline">Baca Berita</a>
        </div>
        <div class="error-suggestions">
          <p>Atau coba navigasi ke:</p>
          <ul>
            <li><a href="/category/berita">Berita Crypto Terbaru</a></li>
            <li><a href="/category/airdrop">Update Airdrop</a></li>
            <li><a href="/category/defi">DeFi & Token</a></li>
            <li><a href="/category/tutorial">Tutorial</a></li>
            <li><a href="/about">Tentang CryptoSynth</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 0;
  }

  .error-content {
    max-width: 500px;
  }

  .error-code {
    font-family: 'Inter', sans-serif;
    font-size: 8rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
    background: linear-gradient(135deg, #1A5DE3, #23D1BE);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
  }

  .error-content h1 {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .error-content p {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .error-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .error-suggestions {
    border-top: 1px solid var(--border);
    padding-top: 2rem;
  }

  .error-suggestions p {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .error-suggestions ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .error-suggestions li a {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 0.8rem;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .error-suggestions li a:hover {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
  }
</style>
