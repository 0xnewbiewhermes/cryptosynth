---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { relativeTime } from '../utils/relativeTime';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

// Trending: most recent 5 for sidebar
const trending = posts.slice(0, 5);
---

<BaseLayout title="CryptoSynth.id — Ringkasan Berita Web3 Setiap Hari">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-layout">
      <!-- Hero Main -->
      <div class="hero-main">
        <div class="hero-badge">
          <span class="hero-badge-dot"></span>
          Updated daily dari sumber kredibel global
        </div>
        <h1>Ringkasan Berita Web3<br/>Terbaru Setiap Hari</h1>
        <p class="hero-subtitle">TL;DR dari CoinDesk, The Block, dan sumber global lainnya &mdash; diringkas khusus untuk pembaca Indonesia.</p>
        <div class="hero-buttons">
          <a href="/category/berita" class="btn btn-primary">Baca Berita &rarr;</a>
          <a href="/about" class="btn btn-outline">Tentang Kami</a>
        </div>
        <!-- Ticker in Hero -->
        <div class="hero-ticker">
          <div class="hero-ticker-item" id="hero-ticker-btc">
            <span class="hero-ticker-symbol">BTC</span>
            <span class="hero-ticker-price">--</span>
            <span class="hero-ticker-change">--</span>
          </div>
          <div class="hero-ticker-item" id="hero-ticker-eth">
            <span class="hero-ticker-symbol">ETH</span>
            <span class="hero-ticker-price">--</span>
            <span class="hero-ticker-change">--</span>
          </div>
          <div class="hero-ticker-item" id="hero-ticker-sol">
            <span class="hero-ticker-symbol">SOL</span>
            <span class="hero-ticker-price">--</span>
            <span class="hero-ticker-change">--</span>
          </div>
        </div>
      </div>

      <!-- Trending Sidebar -->
      <div class="hero-trending">
        <h3 class="hero-trending-title">Trending Hari Ini</h3>
        <div class="hero-trending-list">
          {trending.map((post, i) => (
            <a href={`/blog/${post.id}`} class="hero-trending-item">
              <span class="hero-trending-num">{i + 1}</span>
              <div class="hero-trending-info">
                <span class="hero-trending-cat">{post.data.category || 'Berita'}</span>
                <h4 class="hero-trending-name">{post.data.title}</h4>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Articles Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Berita Terbaru</h2>
        <a href="/articles" class="section-link">Lihat Semua &rarr;</a>
      </div>
      <div class="articles-grid">
        {posts.slice(0, 9).map((post) => (
          <article class="article-card">
            <div class="card-image">
              <img src={`/images/hero/${post.id}.png`} alt={post.data.title} loading="lazy" />
            </div>
            <div class="card-content">
              <div class="card-tags">
                <a href={`/category/${post.data.category?.toLowerCase() || 'berita'}`} class="card-category">
                  {post.data.category || 'Berita'}
                </a>
                {(post.data.tags || []).slice(0, 2).map((tag) => (
                  <span class="card-tag">#{tag}</span>
                ))}
              </div>
              <h3 class="card-title">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="card-excerpt">{post.data.excerpt || post.data.description}</p>
              <div class="card-meta">
                <span class="card-relative-time" data-pubdate={new Date(post.data.pubDate).toISOString()}>{relativeTime(post.data.pubDate)}</span>
                <span class="card-date-sep">·</span>
                <span>{new Date(post.data.pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' })}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      {posts.length > 9 && (
        <div style="text-align: center; padding: 2.5rem 0 1rem;">
          <a href="/articles" class="btn btn-outline" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 2rem; font-size: 0.95rem;">
            Berita Selengkapnya &rarr;
          </a>
        </div>
      )}

      {posts.length === 0 && (
        <div style="text-align: center; padding: 4rem 0; color: var(--text-muted);">
          <p style="font-size: 1.1rem; margin-bottom: 0.5rem;">Artikel pertama akan segera hadir</p>
          <p style="font-size: 0.9rem;">Kami sedang menyiapkan konten terbaik untuk Anda.</p>
        </div>
      )}
    </div>
  </section>

  <script>
    // Hero ticker — same data as header ticker
    (function initHeroTicker() {
      var coins = { bitcoin: 'btc', ethereum: 'eth', solana: 'sol' };
      var lastPrices = {};

      function formatPrice(price) {
        if (price >= 1000) return '$' + price.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
        if (price >= 1) return '$' + price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        return '$' + price.toLocaleString('en-US', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
      }

      function updateTicker(data) {
        Object.keys(coins).forEach(function(id) {
          var el = document.getElementById('hero-ticker-' + coins[id]);
          if (!el || !data[id]) return;
          var priceEl = el.querySelector('.hero-ticker-price');
          var changeEl = el.querySelector('.hero-ticker-change');
          var price = data[id].usd;
          var change = data[id].usd_24h_change || 0;

          priceEl.textContent = formatPrice(price);
          changeEl.textContent = (change >= 0 ? '+' : '') + change.toFixed(2) + '%';
          changeEl.className = 'hero-ticker-change ' + (change >= 0 ? 'ticker-up' : 'ticker-down');

          if (lastPrices[id] && lastPrices[id] !== price) {
            priceEl.classList.add('ticker-flash');
            setTimeout(function() { priceEl.classList.remove('ticker-flash'); }, 600);
          }
          lastPrices[id] = price;
        });
      }

      function fetchPrices() {
        fetch('/api/prices.json')
          .then(function(res) { return res.json(); })
          .then(updateTicker)
          .catch(function() {});
      }

      fetchPrices();
      setInterval(fetchPrices, 60000);
    })();
  </script>
</BaseLayout>
