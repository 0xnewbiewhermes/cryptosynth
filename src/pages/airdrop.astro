---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { relativeTime } from '../utils/relativeTime';

const posts = (await getCollection('blog', (p) => p.data.category?.toLowerCase() === 'airdrop')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<BaseLayout title="Airdrop Update - CryptoSynth.id" description="Peluang airdrop terbaru, tutorial klaim, dan update project web3 yang sedang bagi-bagi token.">
  <div class="page-hero">
    <div class="container">
      <h1>Airdrop Update</h1>
      <p>Peluang airdrop terbaru, tutorial klaim, dan update project web3.</p>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="tools-shortcut-grid" style="margin-bottom: 2rem;">
        <a href="/tools" class="tool-card">
          <div class="tool-icon">🪂</div>
          <div class="tool-content">
            <h4>Airdrop Tracker</h4>
            <p>Risk, sybil, cost & detail lengkap — 11+ proyek</p>
          </div>
        </a>
        <a href="/category/airdrop" class="tool-card" style="text-decoration: none;">
          <div class="tool-icon">📝</div>
          <div class="tool-content">
            <h4>Panduan Airdrop</h4>
            <p>Tutorial, strategi, dan tips klaim airdrop</p>
          </div>
        </a>
      </div>
      <div class="articles-grid">
        {posts.map((post) => (
          <article class="article-card">
            <div class="card-image">
              <img src={`/images/hero/${post.id}.png`} alt={post.data.title} width="1200" height="630" loading="lazy" />
            </div>
            <div class="card-content">
              <div class="card-tags">
                <a href={`/category/${post.data.category?.toLowerCase() || 'airdrop'}`} class="card-category">
                  {post.data.category || 'Airdrop'}
                </a>
                {(post.data.tags || []).slice(0, 2).map((tag) => (
                  <span class="card-tag">#{tag}</span>
                ))}
              </div>
              <h3 class="card-title">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="card-excerpt">{post.data.excerpt || post.data.description}</p>
              <div class="card-meta">
                <span class="card-relative-time" data-pubdate={new Date(post.data.pubDate).toISOString()}>{relativeTime(post.data.pubDate)}</span>
                <span class="card-date-sep">·</span>
                <span>{new Date(post.data.pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' })}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
