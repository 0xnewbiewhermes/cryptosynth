---
import SeoHead from '../components/SeoHead.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: string;
  modifiedDate?: string;
  category?: string;
  tags?: string[];
  faq?: string;
}

const { title, description, image, type = 'website', publishDate, modifiedDate, category, tags = [], faq = '' } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <SeoHead {title} {description} {image} {type} {publishDate} {modifiedDate} {category} {tags} {faq} />
    <link rel="alternate" type="application/rss+xml" title="CryptoSynth.id RSS" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://api.coingecko.com" />
    <link rel="dns-prefetch" href="https://api.coingecko.com" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1E40AF" />
    <meta name="color-scheme" content="light dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <!-- Preload critical assets -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" as="style" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <!-- Skip to content — keyboard accessibility -->
    <a href="#main-content" class="skip-link">Langsung ke konten</a>
    <header class="header">
      <div class="header-inner">
        <a href="/" class="logo">
          <span class="logo-text">Crypto<span class="logo-accent">Synth</span></span>
        </a>
        <nav class="nav" id="mainNav">
          <a href="/">Journal</a>
          <a href="/category/node">Node</a>
          <a href="/tools">Tools</a>
          <a href="/about">Tentang</a>
        </nav>
        <div class="header-actions">
          <button type="button" class="search-pill" id="searchToggle" aria-label="Cari artikel">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            Cari artikel
          </button>
          <button type="button" class="menu-toggle" id="menuToggle" aria-label="Toggle menu">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
          </button>
        </div>
      </div>

      <!-- Search Dropdown (Apple-style) - di dalam header biar position absolute jalan -->
      <div class="search-dropdown" id="searchDropdown">
        <div class="search-dropdown-inner">
          <div class="search-dropdown-input-wrap">
            <svg class="search-dropdown-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="searchDropdownInput" class="search-dropdown-input" placeholder="Cari artikel..." autocomplete="off" aria-label="Cari artikel" />
            <button type="button" class="search-dropdown-clear" id="searchDropdownClear" aria-label="Tutup pencarian">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
          <div id="searchDropdownResults" class="search-dropdown-results" aria-live="polite" role="region" aria-label="Hasil pencarian">
          </div>
        </div>
      </div>
    </header>

    <!-- Professional Live Price Ticker -->
    <div class="ticker-bar" id="tickerBar">
      <div class="ticker-marquee">
        <div class="ticker-track" id="tickerTrack">
          <div class="ticker-item" id="ticker-btc" data-coin="bitcoin">
            <svg class="ticker-icon" viewBox="0 0 32 32"><circle cx="16" cy="16" r="16" fill="#F7931A"/><text x="16" y="21" text-anchor="middle" fill="#fff" font-size="14" font-weight="700">₿</text></svg>
            <div class="ticker-info">
              <span class="ticker-symbol">BTC</span>
              <span class="ticker-price">--</span>
            </div>
            <div class="ticker-meta">
              <span class="ticker-change">--</span>
              
            </div>
          </div>
          <span class="ticker-divider"></span>
          <div class="ticker-item" id="ticker-eth" data-coin="ethereum">
            <svg class="ticker-icon" viewBox="0 0 32 32"><circle cx="16" cy="16" r="16" fill="#627EEA"/><polygon points="16,4 8,16.5 16,22 24,16.5" fill="#fff" opacity="0.9"/><polygon points="16,22 8,16.5 16,28 24,16.5" fill="#fff" opacity="0.6"/></svg>
            <div class="ticker-info">
              <span class="ticker-symbol">ETH</span>
              <span class="ticker-price">--</span>
            </div>
            <div class="ticker-meta">
              <span class="ticker-change">--</span>
              
            </div>
          </div>
          <span class="ticker-divider"></span>
          <div class="ticker-item" id="ticker-sol" data-coin="solana">
            <svg class="ticker-icon" viewBox="0 0 32 32"><circle cx="16" cy="16" r="16" fill="#9945FF"/><path d="M8 20h16l-3 4H11z" fill="#fff"/><path d="M8 12h16l-3 4H11z" fill="#fff" opacity="0.8"/><path d="M8 16h16l-3 4H11z" fill="#fff" opacity="0.6"/></svg>
            <div class="ticker-info">
              <span class="ticker-symbol">SOL</span>
              <span class="ticker-price">--</span>
            </div>
            <div class="ticker-meta">
              <span class="ticker-change">--</span>
              
            </div>
          </div>
          <span class="ticker-divider"></span>
          <div class="ticker-item" id="ticker-bnb" data-coin="binancecoin">
            <svg class="ticker-icon" viewBox="0 0 32 32"><circle cx="16" cy="16" r="16" fill="#F3BA2F"/><text x="16" y="21" text-anchor="middle" fill="#fff" font-size="12" font-weight="700">BNB</text></svg>
            <div class="ticker-info">
              <span class="ticker-symbol">BNB</span>
              <span class="ticker-price">--</span>
            </div>
            <div class="ticker-meta">
              <span class="ticker-change">--</span>
              
            </div>
          </div>
          <span class="ticker-divider"></span>
          <div class="ticker-item" id="ticker-xrp" data-coin="ripple">
            <svg class="ticker-icon" viewBox="0 0 32 32"><circle cx="16" cy="16" r="16" fill="#23292F"/><text x="16" y="21" text-anchor="middle" fill="#fff" font-size="12" font-weight="700">X</text></svg>
            <div class="ticker-info">
              <span class="ticker-symbol">XRP</span>
              <span class="ticker-price">--</span>
            </div>
            <div class="ticker-meta">
              <span class="ticker-change">--</span>
              
            </div>
          </div>
          <span class="ticker-divider"></span>
          <div class="ticker-item" id="ticker-doge" data-coin="dogecoin">
            <svg class="ticker-icon" viewBox="0 0 32 32"><circle cx="16" cy="16" r="16" fill="#C2A633"/><text x="16" y="22" text-anchor="middle" fill="#fff" font-size="16" font-weight="700">Ð</text></svg>
            <div class="ticker-info">
              <span class="ticker-symbol">DOGE</span>
              <span class="ticker-price">--</span>
            </div>
            <div class="ticker-meta">
              <span class="ticker-change">--</span>
              
            </div>
          </div>
          <span class="ticker-divider"></span>
          <div class="ticker-item" id="ticker-ada" data-coin="cardano">
            <svg class="ticker-icon" viewBox="0 0 32 32"><circle cx="16" cy="16" r="16" fill="#0033AD"/><text x="16" y="21" text-anchor="middle" fill="#fff" font-size="12" font-weight="700">₳</text></svg>
            <div class="ticker-info">
              <span class="ticker-symbol">ADA</span>
              <span class="ticker-price">--</span>
            </div>
            <div class="ticker-meta">
              <span class="ticker-change">--</span>
              
            </div>
          </div>
        </div>
      </div>
    </div>
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="/" class="logo footer-logo">
            <span class="logo-text">Crypto<span class="logo-accent">Synth</span></span>
          </a>
          <p>Catatan crypto dari Kalimantan. Node logs, portfolio tracker, dan opini dari seseorang yang jalanin node dan farming airdrop setiap hari.</p>
        </div>
        <div class="footer-col">
          <h4>Jelajahi</h4>
          <a href="/">Journal</a>
          <a href="/category/node">Node</a>
          <a href="/tools">Tools</a>
          <a href="/articles">Arsip</a>
        </div>
        <div class="footer-col">
          <h4>Perusahaan</h4>
          <a href="/about">Tentang</a>
          <a href="/disclaimer">Disclaimer</a>
          <a href="/privacy">Privacy</a>
        </div>
        <div class="footer-col">
          <h4>Ikuti</h4>
          <a href="https://twitter.com/cryptosynthid" target="_blank" rel="noopener">X (Twitter)</a>
          <a href="mailto:hello@cryptosynth.id">Email</a>
          <a href="/rss.xml">RSS Feed</a>
          <a href="https://saweria.co/cryptosynth" target="_blank" rel="noopener" style="font-weight:600;color:var(--primary)">Dukung ☕</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>&copy; 2026 CryptoSynth</span>
        <span>Update terakhir: <span id="footerUpdateDate"></span></span>
      </div>
    </footer>

    <!-- Scroll to Top -->
    <button type="button" class="scroll-top-btn" id="scrollTopBtn" aria-label="Kembali ke atas">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
    </button>

    <script>
      const toggle = document.getElementById('menuToggle');
      const nav = document.getElementById('mainNav');
      const menuSvg = toggle ? toggle.querySelector('svg') : null;
      if (toggle && nav && menuSvg) {
        // Hamburger: 3 lines — Close (X): diagonal lines
        const hamburgerPath = '<line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/>';
        const closePath = '<line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/>';

        toggle.addEventListener('click', () => {
          const open = nav.classList.toggle('open');
          toggle.classList.toggle('open', open);
          menuSvg.innerHTML = open ? closePath : hamburgerPath;
        });
        nav.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            nav.classList.remove('open');
            toggle.classList.remove('open');
            menuSvg.innerHTML = hamburgerPath;
          });
        });
        document.addEventListener('click', (e) => {
          if (!nav.contains(e.target) && !toggle.contains(e.target)) {
            nav.classList.remove('open');
            toggle.classList.remove('open');
            menuSvg.innerHTML = hamburgerPath;
          }
        });
      }

      // Client-side relative time - updates in real-time in the browser
      (function updateRelativeTimes() {
        function formatRelative(dateStr) {
          var now = new Date();
          var d = new Date(dateStr);
          var diffMs = now.getTime() - d.getTime();
          // Jika artikel di masa depan atau baru saja, tetap "Baru saja" biar konsisten
          if (diffMs < 0) return 'Baru saja';
          var diffSec = Math.floor(diffMs / 1000);
          var diffMin = Math.floor(diffSec / 60);
          var diffHour = Math.floor(diffMin / 60);
          var diffDay = Math.floor(diffHour / 24);
          var diffWeek = Math.floor(diffDay / 7);
          var diffMonth = Math.floor(diffDay / 30);

          if (diffMin < 1) return 'Baru saja';
          if (diffMin < 60) return diffMin + ' menit lalu';
          if (diffHour < 24) return diffHour + ' jam lalu';
          if (diffDay < 7) return diffDay + ' hari lalu';
          if (diffWeek < 4) return diffWeek + ' minggu lalu';
          if (diffMonth < 12) return diffMonth + ' bulan lalu';

          return d.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' });
        }

        function refreshAll() {
          document.querySelectorAll('.card-relative-time[data-pubdate]').forEach(function(el) {
            var pubdate = el.getAttribute('data-pubdate');
            if (pubdate) el.textContent = formatRelative(pubdate);
          });
        }

        refreshAll();
        setInterval(refreshAll, 60000); // update tiap 1 menit
      })();

      // Professional live price ticker - CoinGecko API
      (function initTicker() {
        var coins = {
          bitcoin: 'btc', ethereum: 'eth', solana: 'sol',
          binancecoin: 'bnb', ripple: 'xrp', dogecoin: 'doge', cardano: 'ada'
        };
        var lastPrices = {};

        function formatPrice(price) {
          if (price >= 1000) return '$' + price.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
          if (price >= 1) return '$' + price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          return '$' + price.toLocaleString('en-US', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
        }

        function formatVol(vol) {
          if (vol >= 1e12) return '$' + (vol / 1e12).toFixed(1) + 'T';
          if (vol >= 1e9) return '$' + (vol / 1e9).toFixed(1) + 'B';
          if (vol >= 1e6) return '$' + (vol / 1e6).toFixed(1) + 'M';
          return '$' + vol.toLocaleString('en-US', { maximumFractionDigits: 0 });
        }

        function updateTicker(data) {
          Object.keys(coins).forEach(function(id) {
            var els = document.querySelectorAll('[data-coin="' + id + '"]');
            if (!els.length || !data[id]) return;
            var price = data[id].usd;
            var change = data[id].usd_24h_change || 0;
            var vol = data[id].usd_24h_vol || 0;

            els.forEach(function(el) {
              var priceEl = el.querySelector('.ticker-price');
              var changeEl = el.querySelector('.ticker-change');
              var volEl = el.querySelector('.ticker-vol');

              priceEl.textContent = formatPrice(price);

              var arrow = change >= 0 ? '▲' : '▼';
              changeEl.textContent = arrow + ' ' + (change >= 0 ? '+' : '') + change.toFixed(2) + '%';
              changeEl.className = 'ticker-change ' + (change >= 0 ? 'ticker-up' : 'ticker-down');

              if (volEl && vol > 0) {
                volEl.textContent = 'Vol: ' + formatVol(vol);
              }

              // Flash effect on price change
              if (lastPrices[id] && lastPrices[id] !== price) {
                priceEl.classList.add('ticker-flash');
                setTimeout(function() { priceEl.classList.remove('ticker-flash'); }, 600);
              }
            });
            lastPrices[id] = price;
          });
        }

        function fetchPrices() {
          fetch('/api/prices.json')
            .then(function(res) { return res.json(); })
            .then(updateTicker)
            .catch(function() {});
        }

        fetchPrices();
        setInterval(fetchPrices, 60000);
      })();

      // === Search Dropdown (Apple-style) ===
      (function initSearch() {
        var dropdown = document.getElementById('searchDropdown');
        var toggle = document.getElementById('searchToggle');
        var input = document.getElementById('searchDropdownInput');
        var results = document.getElementById('searchDropdownResults');
        var clearBtn = document.getElementById('searchDropdownClear');
        var searchIndex = [];
        var indexLoaded = false;

        function openSearch() {
          dropdown.classList.add('open');
          document.addEventListener('click', closeOnOutside);
          setTimeout(function() { input.focus(); }, 80);
        }

        function closeSearch() {
          dropdown.classList.remove('open');
          document.removeEventListener('click', closeOnOutside);
          input.value = '';
          results.innerHTML = '';
        }

        function closeOnOutside(e) {
          if (!dropdown.contains(e.target) && e.target !== toggle && !toggle.contains(e.target)) {
            closeSearch();
          }
        }

        toggle.addEventListener('click', function(e) {
          e.stopPropagation();
          if (dropdown.classList.contains('open')) {
            closeSearch();
          } else {
            openSearch();
          }
        });

        clearBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          closeSearch();
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && dropdown.classList.contains('open')) {
            closeSearch();
          }
          if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
            e.preventDefault();
            if (dropdown.classList.contains('open')) { closeSearch(); }
            else { openSearch(); }
          }
        });

        async function loadIndex() {
          if (indexLoaded) return;
          try {
            var res = await fetch('/search-index.json');
            searchIndex = await res.json();
            indexLoaded = true;
          } catch (e) {
            console.error('Search index load failed:', e);
          }
        }

        function formatDate(isoStr) {
          var d = new Date(isoStr);
          return d.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' });
        }

        function doSearch(query) {
          var q = query.toLowerCase().trim();
          if (!q) return [];
          var terms = q.split(/\\s+/);
          return searchIndex.filter(function(item) {
            var haystack = (item.title + ' ' + item.description + ' ' + item.excerpt + ' ' + (item.content || '') + ' ' + item.category + ' ' + item.tags.join(' ')).toLowerCase();
            return terms.every(function(t) { return haystack.includes(t); });
          });
        }

        function renderSearch(query) {
          if (!query.trim()) {
            results.innerHTML = '';
            return;
          }
          var matches = doSearch(query);
          if (matches.length === 0) {
            results.innerHTML = '<p class="search-dropdown-empty">Tidak ditemukan artikel untuk "<strong>' + query + '</strong>"</p>';
            return;
          }
          results.innerHTML = matches.map(function(item) {
            return '<a href="/blog/' + item.id + '" class="search-result-card" onclick="document.getElementById(\'searchDropdown\').classList.remove(\'open\')">' +
              '<img src="/images/hero/' + item.id + '.png" alt="' + item.title.replace(/"/g, '&quot;') + '" class="search-result-img" loading="lazy" />' +
              '<div class="search-result-content">' +
              '<span class="search-result-category">' + item.category + '</span>' +
              '<h3 class="search-result-title">' + item.title + '</h3>' +
              '<p class="search-result-desc">' + item.description + '</p>' +
              '<span class="search-result-date">' + formatDate(item.pubDate) + '</span>' +
              '</div></a>';
          }).join('');
        }

        var debounceTimer;
        input.addEventListener('input', async function(e) {
          await loadIndex();
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(function() {
            renderSearch(e.target.value);
          }, 200);
        });
      })();

      // Duplicate ticker items for seamless marquee loop
      (function initMarquee() {
        var track = document.getElementById('tickerTrack');
        if (!track) return;
        var items = track.querySelectorAll('.ticker-item');
        var dividers = track.querySelectorAll('.ticker-divider');
        for (var i = 0; i < items.length; i++) {
          var clone = items[i].cloneNode(true);
          clone.removeAttribute('id');
          track.appendChild(clone);
          if (i < dividers.length) {
            track.appendChild(dividers[i].cloneNode(true));
          }
        }
      })();

      // Glass navigation on scroll (moved inside script)
      document.addEventListener('DOMContentLoaded', () => {
        const header = document.querySelector('.header');
        if (!header) return;

        window.addEventListener('scroll', () => {
          if (window.scrollY > 10) {
            header.classList.add('scrolled');
          } else {
            header.classList.remove('scrolled');
          }
        });
      });

      // Scroll to top button
      (function() {
        var btn = document.getElementById('scrollTopBtn');
        if (!btn) return;
        window.addEventListener('scroll', function() {
          if (window.scrollY > 400) {
            btn.classList.add('visible');
          } else {
            btn.classList.remove('visible');
          }
        });
        btn.addEventListener('click', function() {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();

      // Register Service Worker
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js').catch(function() {});
        });
      }

      // Auto-update footer date
      (function() {
        var el = document.getElementById('footerUpdateDate');
        if (!el) return;
        var now = new Date();
        var months = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
        el.textContent = now.getDate() + ' ' + months[now.getMonth()] + ' ' + now.getFullYear();
      })();
  // === LIVE RELATIVE TIME ===
      (function() {
        function r(d) {
          var n = Date.now() - d.getTime();
          if (n < 0) return 'Baru saja';
          var s = Math.floor(n / 1e3), m = Math.floor(s / 60), h = Math.floor(m / 60), D = Math.floor(h / 24), w = Math.floor(D / 7), M = Math.floor(D / 30);
          if (m < 1) return 'Baru saja';
          if (m < 60) return m + ' menit lalu';
          if (h < 24) return h + ' jam lalu';
          if (D < 7) return D + ' hari lalu';
          if (w < 4) return w + ' minggu lalu';
          if (M < 12) return M + ' bulan lalu';
          return d.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' });
        }
        function u() {
          var el = document.querySelectorAll('[class*="card-v2-relative"]');
          for (var i = 0; i < el.length; i++) {
            var p = el[i].getAttribute('data-pubdate');
            if (p) el[i].textContent = r(new Date(p));
          }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function() { u(); setInterval(u, 6e4); });
        } else {
          u(); setInterval(u, 6e4);
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
