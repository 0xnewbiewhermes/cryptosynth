---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { relativeTime } from '../utils/relativeTime';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && new Date(post.data.pubDate).getTime() <= Date.now())
  .sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<BaseLayout title="CryptoSynth — Catatan Crypto Personal" description="Catatan crypto pribadi dari Gideon. Node logs, airdrop farming, trading bot, tutorial DeFi, dan opini on-chain dari sudut pandang practitioner Indonesia." terminalPath="~/cryptosynth">
  <div class="terminal-home">
    <!-- Welcome output (visible by default, hidden after first interaction) -->
    <div class="term-welcome" id="termWelcome">
      <pre class="ascii-art" aria-hidden="true"> ██████╗██████╗ ██╗   ██╗██████╗ ████████╗ ██████╗ ███████╗██╗   ██╗███╗   ██╗████████╗██╗  ██╗
██╔════╝██╔══██╗╚██╗ ██╔╝██╔══██╗╚══██╔══╝██╔═══██╗██╔════╝╚██╗ ██╔╝████╗  ██║╚══██╔══╝██║  ██║
██║     ██████╔╝ ╚████╔╝ ██████╔╝   ██║   ██║   ██║███████╗ ╚████╔╝ ██╔██╗ ██║   ██║   ███████║
██║     ██╔══██╗  ╚██╔╝  ██╔═══╝    ██║   ██║   ██║╚════██║  ╚██╔╝  ██║╚██╗██║   ██║   ██╔══██║
╚██████╗██║  ██║   ██║   ██║        ██║   ╚██████╔╝███████║   ██║   ██║ ╚████║   ██║   ██║  ██║
 ╚═════╝╚═╝  ╚═╝   ╚═╝   ╚═╝        ╚═╝    ╚═════╝ ╚══════╝   ╚═╝   ╚═╝  ╚═══╝   ╚═╝   ╚═╝</pre>
      <h1 class="term-line term-highlight home-h1 term-reveal" style="--i:0">Catatan Crypto Personal</h1>
      <div class="term-line term-dim term-reveal" style="--i:1">Node logs, airdrop farming, trading, dan opini crypto dari sudut pandang pribadi.</div>
      <div class="term-line term-reveal" style="--i:2">&nbsp;</div>
      <div class="term-line term-reveal" style="--i:3">Ketik <span class="term-warn">help</span> untuk lihat semua command.</div>
      <div class="term-line term-reveal" style="--i:4">&nbsp;</div>
    </div>

    <!-- Command output area -->
    <div class="term-output-area" id="termOutput"></div>

    <!-- Article list (server-rendered for SEO, styled as terminal output) -->
    <div class="term-articles" id="termArticles">
      <div class="term-line">&nbsp;</div>
      <div class="term-line">
        <span class="term-dim">  NUM  TAG            TITLE                                              DATE</span>
      </div>
      <div class="term-line">
        <span class="term-dim term-border">  ───  ───            ─────                                              ────</span>
      </div>
      {posts.map((post, index) => (
        <a href={`/blog/${post.id}`} class="article-entry" style={`--j:${index}`}>
          <div class="entry-meta">
            <span class="entry-date">{new Date(post.data.pubDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', timeZone: 'Asia/Jakarta' })}</span>
            <span class="entry-time" data-live-time data-pubdate={new Date(post.data.pubDate).toISOString()}>{relativeTime(post.data.pubDate)}</span>
          </div>
          <span class="entry-num">{String(index + 1).padStart(2, '0')}</span>
          <span class="entry-tag">{(post.data.tags || []).slice(0, 2).map((tag) => `#${tag}`).join(' · ')}</span>
          <div class="entry-title">{post.data.title}</div>
          {post.data.excerpt && <div class="entry-excerpt">{post.data.excerpt}</div>}
        </a>
      ))}
      <div class="term-line">&nbsp;</div>
      <div class="term-line term-dim">
        &nbsp;&nbsp;Total: {posts.length} catatan. Tap judul untuk baca.
      </div>
      <div class="term-line">&nbsp;</div>
    </div>

    <!-- Command input -->
    <div class="term-input-line" id="termInputLine">
      <span class="term-prompt">gideon@cryptosynth:~$</span>
      <input type="text" id="termInput" name="command" class="term-input" placeholder="help · ls · grep &lt;keyword&gt;" spellcheck="false" autocomplete="off" autocapitalize="off" aria-label="Terminal command input" />
    </div>

    <!-- Mobile quick actions -->
    <div class="quick-actions" id="quickActions">
      <button class="qa-btn" data-cmd="ls"><svg class="qa-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>ls</button>
      <button class="qa-btn" data-cmd="grep airdrop"><svg class="qa-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>airdrop</button>
      <button class="qa-btn" data-cmd="grep tutorial"><svg class="qa-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>tutorial</button>
      <button class="qa-btn" data-cmd="whoami"><svg class="qa-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>whoami</button>
      <button class="qa-btn" data-cmd="help"><svg class="qa-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>help</button>
      <button class="qa-btn" data-cmd="clear"><svg class="qa-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="9" x2="15" y2="15"/><line x1="15" y1="9" x2="9" y2="15"/></svg>clear</button>
    </div>
  </div>
</BaseLayout>

<style>
  /* Terminal home layout */
  .terminal-home {
    padding: 1.5rem 1.5rem 0;
    max-width: 780px;
    margin: 0 auto;
    min-height: calc(100vh - 64px);
    display: flex;
    flex-direction: column;
  }

  /* ASCII art */
  .ascii-art {
    color: var(--primary);
    font-size: 0.58rem;
    line-height: 1.15;
    margin-bottom: 0.75rem;
    overflow-x: auto;
    white-space: pre;
  }

  /* Terminal lines */
  .term-line {
    font-size: 0.85rem;
    line-height: 1.75;
    margin-bottom: 0.08rem;
  }

  .term-welcome {
    margin-bottom: 1.5rem;
    flex-shrink: 0;
  }

  .term-output-area {
    margin-bottom: 1rem;
    flex-shrink: 0;
  }

  .term-articles {
    margin-bottom: 1rem;
    flex: 1;
    overflow-y: auto;
  }

  /* Input line */
  .term-input-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--border-medium);
    background: var(--bg);
    margin-top: auto;
    flex-shrink: 0;
  }

  .term-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    outline: none;
    caret-color: var(--accent-success);
  }

  .term-input::placeholder {
    color: var(--text-dim);
  }

  /* Quick actions (mobile) — styled in global.css */

  .home-h1 {
    font-size: 0.85rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.75;
  }

  /* Terminal-style reveal animation */
  @media (prefers-reduced-motion: no-preference) {
    .ascii-art {
      opacity: 0;
      animation: term-fade-in 0.6s ease forwards;
    }

    .term-reveal {
      opacity: 0;
      transform: translateY(4px);
      animation: term-reveal 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: calc(0.3s + var(--i, 0) * 0.08s);
    }

    .article-entry {
      opacity: 0;
      animation: term-reveal 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: calc(0.6s + var(--j, 0) * 0.04s);
    }

    @keyframes term-fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes term-reveal {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
  }

  /* Terminal cursor blink on input line */
  @media (prefers-reduced-motion: no-preference) {
    .term-input-line::before {
      content: '';
      display: inline-block;
      width: 0.5rem;
      height: 1rem;
      background: var(--accent-success);
      opacity: 0.7;
      animation: cursor-blink 1.2s step-end infinite;
      margin-right: 0.25rem;
      flex-shrink: 0;
    }

    @keyframes cursor-blink {
      0%, 100% { opacity: 0.7; }
      50% { opacity: 0; }
    }
  }

  /* Help output */
  .help-box {
    border: 1px solid var(--border-medium);
    padding: 0.75rem 1rem;
    margin: 0.5rem 0;
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .help-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 0.75rem;
  }

  .help-cmd {
    color: var(--accent-warn);
    font-weight: 500;
  }

  .help-desc {
    color: var(--text-muted);
  }

  /* Whoami output */
  .whoami-block {
    padding: 0.5rem 0;
    font-size: 0.82rem;
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    .terminal-home {
      padding: 1rem 1rem 7rem;
    }

    .ascii-art {
      font-size: 0.42rem;
    }

    .article-entry {
      grid-template-columns: 25px 1fr;
    }
  }
</style>

<script>
  // Terminal interaction
  const output = document.getElementById('termOutput');
  const input = document.getElementById('termInput') as HTMLInputElement;
  const welcome = document.getElementById('termWelcome');
  const articlesEl = document.getElementById('termArticles');
  const quickActions = document.getElementById('quickActions');

  // Article data for grep/search
  const articleData = Array.from(document.querySelectorAll('.article-entry')).map((el, i) => ({
    num: String(i + 1).padStart(2, '0'),
    title: (el.querySelector('.entry-title') as HTMLElement)?.textContent || '',
    tag: (el.querySelector('.entry-tag') as HTMLElement)?.textContent || '',
    excerpt: (el.querySelector('.entry-excerpt') as HTMLElement)?.textContent || '',
    href: (el as HTMLAnchorElement).href,
    date: (el.querySelector('.entry-date') as HTMLElement)?.textContent || '',
  }));

  let history: string[] = [];
  let historyIdx = -1;

  function print(html: string, cls: string = '') {
    if (!output) return;
    const div = document.createElement('div');
    div.className = 'term-line ' + cls;
    div.innerHTML = html;
    output.appendChild(div);
  }

  function showHelp() {
    print('<div class="help-box">' +
      '<div style="font-weight:600;margin-bottom:0.5rem">COMMAND REFERENCE</div>' +
      '<div class="help-row"><span class="help-cmd">ls</span><span class="help-desc">List semua catatan</span></div>' +
      '<div class="help-row"><span class="help-cmd">cat &lt;slug&gt;</span><span class="help-desc">Baca catatan</span></div>' +
      '<div class="help-row"><span class="help-cmd">grep &lt;keyword&gt;</span><span class="help-desc">Cari catatan</span></div>' +
      '<div class="help-row"><span class="help-cmd">whoami</span><span class="help-desc">Tentang penulis</span></div>' +
      '<div class="help-row"><span class="help-cmd">clear</span><span class="help-desc">Bersihkan layar</span></div>' +
      '<div class="help-row"><span class="help-cmd">help</span><span class="help-desc">Tampilkan bantuan</span></div>' +
      '</div>');
  }

  function showWhoami() {
    print('<div class="whoami-block">' +
      '<div class="term-highlight" style="font-weight:600">Gideon</div>' +
      '<div class="term-dim">Crypto practitioner. Node operator. Airdrop farmer.</div>' +
      '<div class="term-dim">Nulis catatan crypto dari sudut pandang pribadi.</div>' +
      '<div>&nbsp;</div>' +
      '<div class="term-dim">Bukan financial advisor. Bukan portal berita.</div>' +
      '<div>&nbsp;</div>' +
      '<div><span class="term-accent">cryptosynth.id</span></div>' +
      '</div>');
  }

  function doGrep(keyword: string) {
    const q = keyword.toLowerCase();
    const hits = articleData.filter(a =>
      a.title.toLowerCase().includes(q) ||
      a.tag.toLowerCase().includes(q) ||
      a.excerpt.toLowerCase().includes(q)
    );
    if (hits.length === 0) {
      print(`Tidak ditemukan: "${keyword}"`, 'term-warn');
      return;
    }
    print(`Ditemukan ${hits.length} catatan untuk "${keyword}":`, 'term-success');
    hits.forEach(a => {
      const div = document.createElement('div');
      div.className = 'term-line';
      div.innerHTML = `<a href="${a.href}" class="article-entry" style="padding:0.25rem 0.5rem"><span class="entry-num">${a.num}</span><div><div class="entry-title">${a.title}</div></div><span class="entry-date">${a.date}</span></a>`;
      output?.appendChild(div);
    });
  }

  function execCmd(cmd: string) {
    const parts = cmd.trim().split(/\s+/);
    const command = parts[0]?.toLowerCase();
    const arg = parts.slice(1).join(' ');

    // Show the command
    print(`<span class="term-prompt">gideon@cryptosynth:~$</span> <span class="term-cmd">${cmd}</span>`);

    // Hide welcome on first command
    if (welcome) welcome.style.display = 'none';

    switch (command) {
      case '':
        break;
      case 'help':
        showHelp();
        break;
      case 'ls':
      case 'list':
        // Show articles
        if (articlesEl) articlesEl.style.display = 'block';
        print('', '');
        break;
      case 'cat':
      case 'read':
        if (arg) {
          const match = articleData.find(a =>
            a.title.toLowerCase().includes(arg.toLowerCase()) ||
            a.href.includes(arg.toLowerCase())
          );
          if (match) {
            window.location.href = match.href;
          } else {
            print(`cat: ${arg}: No such catatan`, 'term-error');
          }
        } else {
          print('Usage: cat &lt;slug&gt;', 'term-warn');
        }
        break;
      case 'grep':
      case 'search':
        if (arg) {
          doGrep(arg);
        } else {
          print('Usage: grep &lt;keyword&gt;', 'term-warn');
        }
        break;
      case 'whoami':
      case 'about':
        showWhoami();
        break;
      case 'clear':
      case 'cls':
        if (output) output.innerHTML = '';
        if (welcome) welcome.style.display = 'none';
        if (articlesEl) articlesEl.style.display = 'none';
        break;
      case 'exit':
      case 'quit':
        print('Tidak bisa keluar dari CryptoSynth. Lo sudah di dalam.', 'term-warn');
        break;
      case 'sudo':
        print('Nice try. Tapi ini blog, bukan server.', 'term-warn');
        break;
      default:
        print(`Command not found: ${command}. Ketik <span class="term-warn">help</span> untuk bantuan.`, 'term-error');
    }

    // Scroll to show output
    const outputArea = document.getElementById('termOutput');
    if (outputArea && outputArea.lastElementChild) {
      outputArea.lastElementChild.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      window.scrollTo(0, document.body.scrollHeight);
    }
  }

  // Keyboard shortcut: press / anywhere outside a field to open search.
  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if (e.key === '/' && target?.tagName !== 'INPUT' && target?.tagName !== 'TEXTAREA' && !target?.isContentEditable) {
      e.preventDefault();
      document.getElementById('searchToggle')?.click();
    }
  });

  // Input handler
  if (input) {
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const cmd = input.value;
        if (cmd) {
          history.push(cmd);
          historyIdx = history.length;
        }
        execCmd(cmd);
        input.value = '';
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (historyIdx > 0) {
          historyIdx--;
          input.value = history[historyIdx];
        }
      }
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyIdx < history.length - 1) {
          historyIdx++;
          input.value = history[historyIdx];
        } else {
          historyIdx = history.length;
          input.value = '';
        }
      }
      if (e.key === 'l' && e.ctrlKey) {
        e.preventDefault();
        execCmd('clear');
      }
    });
  }

  // Quick action buttons (mobile)
  document.querySelectorAll('.qa-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const cmd = (btn as HTMLElement).dataset.cmd;
      if (cmd) execCmd(cmd);
    });
  });

  // Focus input on terminal area click
  document.querySelector('.terminal-home')?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('a') && !target.closest('button') && !target.closest('.qa-btn')) {
      input?.focus();
    }
  });
</script>
