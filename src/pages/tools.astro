---
import BaseLayout from '../layouts/BaseLayout.astro';
import airdropsData from '../data/airdrops.json';

const statusMap = {
  active: { text: 'Aktif', cls: 'badge-active' },
  upcoming: { text: 'Segera', cls: 'badge-upcoming' },
  ended: { text: 'Berakhir', cls: 'badge-ended' },
  confirmed: { text: 'Terkonfirmasi', cls: 'badge-confirmed' },
};
const riskMap = {
  low: { text: 'Low', cls: 'risk-low' },
  medium: { text: 'Medium', cls: 'risk-medium' },
  high: { text: 'High', cls: 'risk-high' },
};
const costMap = {
  free: { text: 'Free', cls: 'cost-free' },
  low: { text: '<$10', cls: 'cost-low' },
  medium: { text: '$10-50', cls: 'cost-medium' },
  high: { text: '>$50', cls: 'cost-high' },
};
const diffMap = {
  easy: { text: 'Easy', cls: 'diff-easy' },
  medium: { text: 'Medium', cls: 'diff-medium' },
  advanced: { text: 'Advanced', cls: 'diff-advanced' },
};
const sybilMap = {
  low: { text: 'Low', cls: 'sybil-low' },
  medium: { text: 'Medium', cls: 'sybil-medium' },
  high: { text: 'High', cls: 'sybil-high' },
};
const confMap = {
  low: { text: 'Rendah', cls: 'conf-low' },
  medium: { text: 'Sedang', cls: 'conf-medium' },
  high: { text: 'Tinggi', cls: 'conf-high' },
};

const categories = [...new Set(airdropsData.map(a => a.category))].sort();

function formatDate(dateStr) {
  if (!dateStr) return '-';
  const d = new Date(dateStr);
  return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<BaseLayout
  title="Tools"
  description="Airdrop tracker dan scam checker - tools crypto gratis untuk komunitas Indonesia."
>
  <!-- TAB NAVIGATION -->
  <div class="tools-nav">
    <div class="container">
      <div class="tools-tabs" id="toolsTabs">
        <button class="tools-tab active" data-tab="tracker"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 4px;"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg> Airdrop Tracker</button>
        <button class="tools-tab" data-tab="scam"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 4px;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg> Scam Checker</button>
      </div>
    </div>
  </div>

  <!-- TAB: AIRDROP TRACKER -->
  <div class="tools-panel active" id="panel-tracker">
    <div class="page-hero">
      <div class="container">
        <h1><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 6px;"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>Airdrop Tracker</h1>
        <p>Tracker airdrop crypto paling lengkap. Klik kartu untuk melihat detail lengkap - risiko, biaya, wallet, sybil risk, dan lainnya.</p>
      </div>
    </div>
    <div class="tracker-page container">

      <div class="tracker-filters">
        <div class="filter-group">
          <label class="filter-label">Kategori:</label>
          <div class="filter-pills" id="categoryFilters">
            <button class="filter-pill active" data-category="all">Semua</button>
            {categories.map(cat => (
              <button class="filter-pill" data-category={cat}>{cat}</button>
            ))}
          </div>
        </div>
        <div class="filter-group">
          <label class="filter-label" for="trackerSearch">Cari:</label>
          <input type="text" id="trackerSearch" name="search" class="tracker-search-input" placeholder="Nama project…" />
        </div>
      </div>

      <div class="tracker-count">
        Menampilkan <strong id="visibleCount">{airdropsData.length}</strong> dari <strong>{airdropsData.length}</strong> airdrop
      </div>

      <div class="airdrop-cards" id="airdropCards">
        {airdropsData.map((a, idx) => {
          const st = statusMap[a.status] || statusMap.active;
          const rk = riskMap[a.risk] || riskMap.medium;
          const ct = costMap[a.cost] || costMap.low;
          const df = diffMap[a.difficulty] || diffMap.medium;
          const sy = sybilMap[a.sybil] || sybilMap.medium;
          const cf = confMap[a.rewardConfidence] || confMap.medium;
          return (
            <div class="airdrop-card" data-category={a.category} data-project={a.project.toLowerCase()}>
              <div class="card-summary" data-idx={idx}>
                <div class="card-left">
                  <div class="card-project">
                    <a href={a.link} target="_blank" rel="noopener noreferrer" class="card-project-link">
                      <span class="card-project-name">{a.project}</span>
                      {a.symbol && a.symbol !== 'TBD' && <span class="card-project-symbol">{a.symbol}</span>}
                    </a>
                    <span class="card-chain">{a.chain}</span>
                  </div>
                  <div class="card-badges">
                    <span class={`badge ${st.cls}`}>{st.text}</span>
                    <span class={`badge ${rk.cls}`}>Risk: {rk.text}</span>
                    <span class={`badge ${ct.cls}`}>Cost: {ct.text}</span>
                    <span class={`badge ${df.cls}`}>{df.text}</span>
                  </div>
                </div>
                <div class="card-right">
                  <span class="card-verified">✓ {formatDate(a.lastVerified)}</span>
                  <button class="card-expand-btn" aria-label="Lihat detail">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M6 8l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                </div>
              </div>
              <div class="card-detail" id={`detail-${idx}`}>
                <div class="detail-grid">
                  <div class="detail-item">
                    <span class="detail-label">Aksi yang Diperlukan</span>
                    <span class="detail-value">{a.action}</span>
                  </div>
                  <div class="detail-item">
                    <span class="detail-label">Deadline</span>
                    <span class="detail-value">{a.deadline}</span>
                  </div>
                  <div class="detail-item">
                    <span class="detail-label">Estimasi Reward</span>
                    <span class="detail-value">{a.estimated}</span>
                  </div>
                  <div class="detail-item">
                    <span class="detail-label">Waktu yang Dibutuhkan</span>
                    <span class="detail-value">{a.timeNeeded}</span>
                  </div>
                  <div class="detail-item">
                    <span class="detail-label">Wallet yang Dibutuhkan</span>
                    <span class="detail-value">{a.wallet}</span>
                  </div>
                  <div class="detail-item">
                    <span class="detail-label">Network</span>
                    <span class="detail-value">
                      <span class={`badge ${a.network === 'Mainnet' ? 'net-mainnet' : 'net-testnet'}`}>{a.network}</span>
                    </span>
                  </div>
                  <div class="detail-item">
                    <span class="detail-label">Sybil Risk</span>
                    <span class="detail-value">
                      <span class={`badge ${sy.cls}`}>Sybil: {sy.text}</span>
                    </span>
                  </div>
                  <div class="detail-item">
                    <span class="detail-label">Potensi Reward</span>
                    <span class="detail-value">
                      <span class={`badge ${cf.cls}`}>{cf.text}</span>
                    </span>
                  </div>
                  {a.announcement && (
                    <div class="detail-item detail-full">
                      <span class="detail-label">Pengumuman Resmi</span>
                      <span class="detail-value">
                        <a href={a.announcement} target="_blank" rel="noopener noreferrer" class="detail-link">Lihat Pengumuman →</a>
                      </span>
                    </div>
                  )}
                  {a.tutorial && (
                    <div class="detail-item detail-full">
                      <span class="detail-label">Tutorial CryptoSynth</span>
                      <span class="detail-value">
                        <a href={a.tutorial} class="detail-link">Baca Tutorial →</a>
                      </span>
                    </div>
                  )}
                  {a.notes && (
                    <div class="detail-item detail-full">
                      <span class="detail-label">Catatan</span>
                      <span class="detail-value detail-notes">{a.notes}</span>
                    </div>
                  )}
                </div>
                <div class="detail-actions">
                  <a href={a.link} target="_blank" rel="noopener noreferrer" class="detail-btn detail-btn-primary">
                    Kunjungi Website →
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <div class="tracker-disclaimer">
        <strong>Disclaimer:</strong> Informasi di halaman ini bersifat informatif dan bukan saran investasi. Selalu verifikasi dari sumber resmi project sebelum berpartisipasi. Airdrop bisa berubah sewaktu-waktu tanpa pemberitahuan.
      </div>
    </div>
  </div>

  <!-- TAB: SCAM CHECKER -->
  <div class="tools-panel" id="panel-scam">
    <section class="scam-hero">
      <div class="scam-hero-bg"></div>
      <div class="container">
        <div class="scam-hero-content">
          <div class="scam-hero-badge">
            <span class="scam-hero-dot"></span>
            Keamanan Dulu, Baru Transaksi
          </div>
          <h2 class="scam-hero-title"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 6px;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>Cek Scam Crypto</h2>
          <p class="scam-hero-desc">
            Masukkan domain atau address crypto untuk cek apakah terdaftar sebagai scam di database phishing global kami.
          </p>
          <div class="scam-form-card">
            <div class="scam-form-card-inner">
              <form class="scam-form" id="checkForm">
                <div class="scam-input-wrap">
                  <svg class="scam-input-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                  </svg>
                  <input
                    type="text"
                    id="checkInput"
                    name="query"
                    class="scam-input"
                    placeholder="Contoh: interest-tydro.com atau 0x… atau address Solana…"
                    autocomplete="off"
                    spellcheck="false"
                    aria-label="Cek domain atau address crypto"
                    required
                  />
                </div>
                <button type="submit" class="scam-btn" id="checkBtn" disabled title="Tunggu database siap">
                  <span id="btnText">Memuat database...</span>
                  <span id="btnSpinner" class="scam-spinner" style="display:inline-block"></span>
                </button>
              </form>
              <p class="scam-form-hint">Domain, wallet address, atau kontrak token - diperiksa dari 9 sumber: blacklist lokal, VirusTotal, Google Safe Browsing, URLScan, URLhaus, SURBL, URIBL, Go+ Security, dan deteksi Cyrillic homograph</p>
            </div>
          </div>
          <div class="scam-stats" id="scamStats">
            <div class="scam-stat-pulse"></div>
            <span id="statsText">Memuat database...</span>
          </div>
        </div>
      </div>
    </section>

    <section class="scam-result-section" id="checkResult" style="display:none">
      <div class="container">
        <div class="scam-result-card" id="resultCard">
          <div class="scam-result-glow"></div>
          <div class="scam-result-inner">
            <div class="scam-result-icon-wrap" id="resultIconWrap">
              <span class="scam-result-icon" id="resultIcon"></span>
            </div>
            <div class="scam-result-body">
              <h2 class="scam-result-title" id="resultTitle"></h2>
              <p class="scam-result-detail" id="resultDetail"></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="scam-sources-section">
      <div class="container">
        <div class="scam-sources">
          <h3 class="scam-sources-title">Sumber Data</h3>
          <div class="scam-sources-grid">
            <div class="scam-source-item">
              <div class="scam-source-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
              <div class="scam-source-info">
                <strong>ScamSniffer</strong>
                <span>347rb domain + 2.530 address phishing crypto</span>
              </div>
            </div>
            <div class="scam-source-item">
              <div class="scam-source-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg></div>
              <div class="scam-source-info">
                <strong>jarelllama/Scam-Blocklist</strong>
                <span>487rb domain scam & phishing umum</span>
              </div>
            </div>
            <div class="scam-source-item">
              <div class="scam-source-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
              <div class="scam-source-info">
                <strong>phishdestroy/destroylist</strong>
                <span>149rb domain phishing aktif</span>
              </div>
            </div>
            <div class="scam-source-item">
              <div class="scam-source-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></div>
              <div class="scam-source-info">
                <strong>IDN Homograph Detection</strong>
                <span>Deteksi Cyrillic lookalike, invisible chars, punycode abuse (lokal)</span>
              </div>
            </div>
            <div class="scam-source-item">
              <div class="scam-source-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
              <div class="scam-source-info">
                <strong>VirusTotal</strong>
                <span>70+ AV engine scan, domain reputation, WHOIS</span>
              </div>
            </div>
            <div class="scam-source-item">
              <div class="scam-source-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></div>
              <div class="scam-source-info">
                <strong>Google Safe Browsing</strong>
                <span>DB phishing & malware Google (10K cek/hari)</span>
              </div>
            </div>
            <div class="scam-source-item">
              <div class="scam-source-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></div>
              <div class="scam-source-info">
                <strong>URLScan.io</strong>
                <span>URL scanner: screenshot, DOM, verdicts komunitas</span>
              </div>
            </div>
            <div class="scam-source-item">
              <div class="scam-source-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
              <div class="scam-source-info">
                <strong>URLhaus (abuse.ch)</strong>
                <span>Database malware URL oleh abuse.ch</span>
              </div>
            </div>
            <div class="scam-source-item">
              <div class="scam-source-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
              <div class="scam-source-info">
                <strong>SURBL + URIBL</strong>
                <span>DNS blocklist untuk domain spam & phishing</span>
              </div>
            </div>
            <div class="scam-source-item">
              <div class="scam-source-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></div>
              <div class="scam-source-info">
                <strong>Go+ Security API</strong>
                <span>Analisis token real-time: honeypot, tax, blacklist (40+ chain)</span>
              </div>
            </div>
          </div>
          <p class="scam-sources-note">Database lokal diperbarui otomatis setiap 6 jam. API eksternal butuh key gratis. Selalu verifikasi sebelum bertransaksi.</p>
        </div>
      </div>
    </section>
  </div>

</BaseLayout>

<style>
  /* ===== TOOLS TAB NAV ===== */
  .tools-nav {
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-medium);
    position: sticky;
    top: var(--nav-height);
    z-index: 50;
  }

  .tools-tabs {
    display: flex;
    gap: 0;
  }

  .tools-tab {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.85rem 1rem;
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    font-family: var(--font-mono);
    border-bottom: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    position: relative;
  }

  .tools-tab:hover {
    color: var(--text-secondary);
    background: var(--bg-hover);
  }

  .tools-tab.active {
    color: var(--primary-light);
    border-bottom-color: var(--primary);
  }

  .tools-panel {
    display: none;
  }

  .tools-panel.active {
    display: block;
  }

  /* ===== PAGE HERO ===== */
  .page-hero {
    padding: 1.5rem 0 1rem;
    border-bottom: 1px solid var(--border);
  }
  .page-hero h1 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }
  .page-hero p {
    color: var(--text-muted);
    font-size: 0.85rem;
    max-width: 560px;
    line-height: 1.5;
  }

  /* ===== TRACKER PAGE ===== */
  .tracker-page {
    padding: 1.25rem 1.5rem 2rem;
  }

  .tracker-filters {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .filter-label {
    font-size: 0.84rem;
    color: var(--text-muted);
    font-weight: 500;
    white-space: nowrap;
  }
  .filter-pills {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }
  .filter-pill {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.3rem 0.65rem;
    background: transparent;
    border: 1px solid var(--border-heavy);
    color: var(--text-muted);
    cursor: pointer;
    border-radius: var(--radius);
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .filter-pill:hover {
    border-color: var(--primary);
    color: var(--primary-light);
  }
  .filter-pill:focus-visible {
    outline: 2px solid var(--primary-light);
    outline-offset: 2px;
  }
  .filter-pill.active {
    background: rgba(59, 130, 246, 0.12);
    border-color: var(--primary);
    color: var(--primary-light);
  }

  .tracker-search-input {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    padding: 0.4rem 0.75rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-medium);
    color: var(--text-primary);
    border-radius: var(--radius);
    outline: none;
    width: 180px;
    transition: border-color 0.2s;
  }
  .tracker-search-input::placeholder { color: var(--text-dim); }
  .tracker-search-input:focus { border-color: var(--primary); }

  .tracker-count {
    font-size: 0.84rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
  .tracker-count strong { color: var(--text-secondary); }

  /* ===== AIRDROP CARDS ===== */
  .airdrop-cards {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .airdrop-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s, background 0.15s;
  }
  .airdrop-card:hover {
    border-color: var(--border-heavy);
  }
  .airdrop-card.expanded {
    border-color: rgba(59, 130, 246, 0.25);
    background: rgba(59, 130, 246, 0.02);
  }

  .card-summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    cursor: pointer;
    transition: background 0.15s;
    user-select: none;
  }
  .card-summary:hover {
    background: var(--border-light);
  }
  .card-summary:focus-visible {
    outline: 2px solid var(--primary-light);
    outline-offset: -2px;
  }

  .card-left {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .card-project {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .card-project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .card-project-link:hover { opacity: 0.8; }
  .card-project-name {
    font-size: 0.88rem;
