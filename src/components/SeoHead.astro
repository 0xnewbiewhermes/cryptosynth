---
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishDate?: string;
  modifiedDate?: string;
  author?: string;
  category?: string;
  tags?: string[];
  faq?: string | { question: string; answer: string }[];
}

const {
  title,
  description = "CryptoSynth.id - Web3 Insights Daily. Berita crypto, airdrop, DeFi, dan analisis harian dari sumber kredibel global.",
  image = "/images/og-default.png",
  imageAlt = "CryptoSynth.id - Ringkasan Berita Web3 Harian",
  canonical,
  type = "website",
  publishDate,
  modifiedDate,
  author = "CryptoSynth",
  category,
  tags = [],
  faq = []
} = Astro.props;

// Normalize canonical: always use base site URL, strip www, trailing slash, and query params
const rawPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalURL = canonical || new URL(rawPath, Astro.site).href;
const fullImageURL = new URL(image, Astro.site).href;

// Build keywords from tags (specific per article) or category (for category pages)
// Helper: truncate title for <title> tag (keep under 60 chars total with brand suffix)
const brandSuffix = ' | CryptoSynth.id';
const maxTitleLen = 60 - brandSuffix.length;

// Truncate meta description to 155 chars (Google cuts at ~160)
const truncateDesc = (d) => {
  if (!d || d.length <= 155) return d;
  const truncated = d.substring(0, 152);
  const lastSpace = truncated.lastIndexOf(' ');
  return (lastSpace > 100 ? truncated.substring(0, lastSpace) : truncated) + '…';
};
const seoDescription = truncateDesc(description);

const truncateForSeo = (t) => {
  if (t.length <= maxTitleLen) return t;
  const truncated = t.substring(0, maxTitleLen - 1);
  const lastSpace = truncated.lastIndexOf(' ');
  return (lastSpace > maxTitleLen * 0.7 ? truncated.substring(0, lastSpace) : truncated) + '…';
};
const seoTitle = truncateForSeo(title);
const keywords = tags && tags.length > 0
  ? tags.join(', ')
  : category
    ? `${category}, crypto, web3, blockchain, DeFi, Indonesia`
    : "crypto, web3, blockchain, DeFi, airdrop, berita crypto Indonesia";

// JSON-LD: WebSite schema ONLY on non-article pages (homepage, category, about, etc.)
const websiteSchema = type !== "article" ? {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "CryptoSynth.id",
  "url": "https://cryptosynth.id",
  "description": "Portal berita web3 Indonesia. Ringkasan harian dari sumber kredibel global.",
  "inLanguage": "id",
  "publisher": {
    "@type": "Organization",
    "name": "CryptoSynth",
    "url": "https://cryptosynth.id",
    "logo": {
      "@type": "ImageObject",
      "url": "https://cryptosynth.id/images/cryptosynth-logo.png"
    }
  }
} : null;

// JSON-LD: NewsArticle schema for article pages
const articleSchema = type === "article" ? {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": title,
  "description": description,
  "image": fullImageURL,
  "datePublished": publishDate,
  "dateModified": modifiedDate || publishDate,
  "author": {
    "@type": "Organization",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": "CryptoSynth",
    "logo": {
      "@type": "ImageObject",
      "url": "https://cryptosynth.id/images/cryptosynth-logo.png",
      "width": 1075,
      "height": 724
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL
  },
  "inLanguage": "id",
  "isAccessibleForFree": true,
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".article-title", ".article-excerpt"]
  },
  ...(tags.length > 0 ? { "keywords": tags.join(', ') } : {})
} : null;

// JSON-LD: BreadcrumbList for articles
const breadcrumbSchema = type === "article" && category ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Beranda",
      "item": "https://cryptosynth.id"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": category,
      "item": `https://cryptosynth.id/category/${category.toLowerCase()}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": canonicalURL
    }
  ]
} : null;

// Parse FAQ - handle both string and array formats
const parsedFaq = (() => {
  if (Array.isArray(faq)) return faq;
  if (typeof faq === 'string' && faq.trim()) {
    return faq.split(' || ').map((pair) => {
      const parts = pair.split(';;');
      return { question: parts[0]?.trim() || '', answer: parts[1]?.trim() || '' };
    }).filter((f) => f.question && f.answer);
  }
  return [];
})();

// JSON-LD: FAQPage schema
const faqSchema = parsedFaq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": parsedFaq.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;
---

<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-E43X19WF4V"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-E43X19WF4V');
</script>

<!-- Google Discover: max-image-preview -->
<meta name="robots" content="max-image-preview:large, max-snippet:-1, max-image-preview:standard" />

<!-- Primary Meta -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="google-site-verification" content="SbW87xgyqwwQzLxvrgJfGuNMW1Mcw6Wt9sLPDqpxTxs" />
<meta name="msvalidate.01" content="BEA857BF046569091CA03806980AEA5F" />
<meta name="description" content={seoDescription} />
<meta name="author" content={author} />
<meta name="keywords" content={keywords} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content="CryptoSynth.id" />
<meta property="og:locale" content="id_ID" />
{type === "article" && publishDate && <meta property="article:published_time" content={publishDate} />}
{type === "article" && category && <meta property="article:section" content={category} />}
{type === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageURL} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- JSON-LD Structured Data -->
{websiteSchema && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

<title>{seoTitle} | CryptoSynth.id</title>
