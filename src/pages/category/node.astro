---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { relativeTime } from '../../utils/relativeTime';

const posts = (await getCollection('blog', (p) => p.data.category?.toLowerCase() === 'node')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<BaseLayout title="Node - CryptoSynth.id" description="Catatan operasi node, uptime, dan pengalaman menjalankan berbagai node crypto.">
  <section class="hero-v3">
    <div class="container">
      <div class="hero-v3-label">✦ Kategori</div>
      <h1>Node</h1>
      <p class="hero-v3-subtitle">Catatan operasi node, uptime, dan pengalaman menjalankan berbagai node crypto.</p>
    </div>
  </section>

  <div class="section-divider"></div>

  <section class="section-articles">
    <div class="container">
      <div class="article-rows">
        {posts.map((post, index) => (
          <article class="article-row">
            <div class="article-row-left">
              <div class="article-row-tags">
                {(post.data.tags || []).slice(0, 2).map((tag) => (
                  <span class="article-row-tag">#{tag}</span>
                ))}
              </div>
              <h3 class="article-row-title">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="article-row-excerpt">{post.data.excerpt || post.data.description}</p>
            </div>
            <div class="article-row-right">
              <span class="article-row-time" data-pubdate={new Date(post.data.pubDate).toISOString()}>{relativeTime(post.data.pubDate)}</span>
              <span class="article-row-date">{new Date(post.data.pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' })}</span>
            </div>
          </article>
        ))}
      </div>

      {posts.length === 0 && (
        <div style="text-align: center; padding: 4rem 0; color: var(--text-muted);">
          <p>Belum ada catatan di kategori ini.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>