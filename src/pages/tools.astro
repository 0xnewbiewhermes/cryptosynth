<script>
  // ===== TAB SWITCHING =====
  (function() {
    const tabs = document.querySelectorAll('.tools-tab');
    const panels = {
      tracker: document.getElementById('panel-tracker'),
      scam: document.getElementById('panel-scam'),
    };

    // Restore saved tab
    const saved = localStorage.getItem('tools-active-tab') || 'tracker';

    function switchTab(tabId) {
      tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === tabId));
      Object.keys(panels).forEach(id => {
        panels[id].classList.toggle('active', id === tabId);
      });
      localStorage.setItem('tools-active-tab', tabId);
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => switchTab(tab.dataset.tab));
    });

    // Activate saved tab on load
    switchTab(saved);
  })();

  // ===== TRACKER JS =====
  (function() {
    const pills = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('.airdrop-card');
    const searchInput = document.getElementById('trackerSearch');
    const countEl = document.getElementById('visibleCount');
    if (!pills.length || !cards.length) return;
    let activeCategory = 'all';

    function updateCount() {
      const visible = document.querySelectorAll('.airdrop-card:not([style*="display: none"])').length;
      if (countEl) countEl.textContent = String(visible);
    }

    function filterCards() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      cards.forEach(card => {
        const el = card;
        const cat = el.dataset.category;
        const text = el.textContent?.toLowerCase() || '';
        const catMatch = activeCategory === 'all' || cat === activeCategory;
        const searchMatch = !query || text.includes(query);
        el.style.display = (catMatch && searchMatch) ? '' : 'none';
      });
      updateCount();
    }

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        activeCategory = pill.dataset.category || 'all';
        filterCards();
      });
    });

    searchInput?.addEventListener('input', filterCards);

    document.querySelectorAll('.card-summary').forEach(summary => {
      summary.addEventListener('click', (e) => {
        if (e.target.closest('.card-project-link')) return;
        const idx = summary.dataset.idx;
        const detail = document.getElementById('detail-' + idx);
        const card = summary.closest('.airdrop-card');
        if (detail && card) {
          const isOpen = detail.classList.contains('open');
          document.querySelectorAll('.card-detail.open').forEach(d => d.classList.remove('open'));
          document.querySelectorAll('.airdrop-card.expanded').forEach(c => c.classList.remove('expanded'));
          if (!isOpen) {
            detail.classList.add('open');
            card.classList.add('expanded');
          }
        }
      });
    });
  })();

  // ===== SCAM CHECKER JS =====
  (function() {
    const dataUrl = '/data/scam-alerts.json';
    let scamData = [];
    const form = document.getElementById('checkForm');
    const input = document.getElementById('checkInput');
    const result = document.getElementById('checkResult');
    const resultCard = document.getElementById('resultCard');
    const resultIconWrap = document.getElementById('resultIconWrap');
    const resultIcon = document.getElementById('resultIcon');
    const resultTitle = document.getElementById('resultTitle');
    const resultDetail = document.getElementById('resultDetail');
    const stats = document.getElementById('scamStats');
    const statsText = document.getElementById('statsText');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');
    const btn = document.getElementById('checkBtn');
    if (!form) return;

    const SOURCE_META = {
      'ScamSniffer': { icon: '🛡️', label: 'ScamSniffer' },
      'jarelllama': { icon: '🚫', label: 'jarelllama' },
      'phishdestroy': { icon: '🔥', label: 'phishdestroy' }
    };

    // Load data
    fetch(dataUrl + '?v=' + Date.now())
      .then(r => r.json())
      .then(data => {
        scamData = data;
        const counts = {};
        data.forEach(d => {
          d.source.split(', ').forEach(s => { counts[s] = (counts[s] || 0) + 1; });
        });
        const parts = [];
        if (counts['ScamSniffer']) parts.push(`🛡️ ${(counts['ScamSniffer']).toLocaleString('id-ID')}`);
        if (counts['jarelllama']) parts.push(`🚫 ${(counts['jarelllama']).toLocaleString('id-ID')}`);
        if (counts['phishdestroy']) parts.push(`🔥 ${(counts['phishdestroy']).toLocaleString('id-ID')}`);
        if (statsText) statsText.innerHTML = parts.join(' &bull; ');
      })
      .catch(() => {
        if (statsText) { statsText.innerHTML = 'Gagal memuat database'; }
        if (stats) stats.style.color = '#EF4444';
      });

    function isAddress(input) {
      if (/^0x[a-f0-9]{40}$/i.test(input)) return 'evm';
      if (/^(bc1|[13])[a-zA-Z0-9]{25,62}$/.test(input)) return 'btc';
      if (/^[1-9A-HJ-NP-Za-km-z]{32,44}$/.test(input) && !input.includes('.')) return 'sol';
      return false;
    }

    function normalizeInput(input) {
      let d = input.trim().toLowerCase();
      for (const prefix of ['http://', 'https://', 'www.', 'hxxp://', 'hxxps://', 'ftp://']) {
        if (d.startsWith(prefix)) d = d.slice(prefix.length);
      }
      d = d.replace(/\/+$/, '').replace(/\/$/, '');
      return d;
    }

    function checkBlacklist(input, addrType) {
      if (!input || !scamData.length) return null;
      if (addrType) {
        const match = scamData.find(d => d.type === 'address' && d.key === input);
        return match ? [match] : null;
      }
      const matches = scamData.filter(d =>
        d.type === 'domain' && (
          d.key === input ||
          d.key.endsWith('.' + input) ||
          input.includes(d.key)
        )
      );
      return matches.length > 0 ? matches : null;
    }

    const CHAIN_MAP = {
      evm: 1, bsc: 56, sol: 101, polygon: 137, avalanche: 43114,
      arbitrum: 42161, optimism: 10, base: 8453
    };

    async function checkGoPlus(address, chainId, isSolana, rawInput) {
      try {
        const solParam = isSolana ? '&solana=1' : '';
        const resp = await fetch(
          `/api/goplus?chain=${chainId}&address=${encodeURIComponent(address)}${solParam}`,
          { signal: AbortSignal.timeout(10000) }
        );
        const data = await resp.json();
        const result = data.result || {};
        // Solana preserves original case; try lookupKey, then lowercased, then raw input
        const lookupKey = isSolana ? rawInput : address.toLowerCase();
        const tokenData = result[lookupKey] || result[address.toLowerCase()] || result[address];
        if (!tokenData) return null;
        const flags = [];
        if (tokenData.is_honeypot === '1') flags.push('Honeypot');
        if (tokenData.is_blacklisted === '1') flags.push('Blacklist');
        if (tokenData.cannot_buy === '1') flags.push('Cannot Buy');
        if (tokenData.cannot_sell_all === '1') flags.push('Cannot Sell All');
        if (tokenData.trading_cooldown === '1') flags.push('Trading Cooldown');
        if (tokenData.anti_whale_modifiable === '1') flags.push('Anti-Whale Modifiable');
        if (tokenData.can_take_back_ownership === '1') flags.push('Ownership Can Be Taken');
        if (tokenData.owner_change_balance === '1') flags.push('Owner Can Change Balance');
        if (tokenData.hidden_owner === '1') flags.push('Hidden Owner');
        if (tokenData.selfdestruct === '1') flags.push('Self-Destruct');
        if (tokenData.external_call === '1') flags.push('External Call');
        if (tokenData.is_airdrop_scam === '1') flags.push('Airdrop Scam');
        if (tokenData.trust_list === '0' && tokenData.is_blacklisted !== '1') flags.push('Not on Trust List');
        const buyTax = parseFloat(tokenData.buy_tax || '0');
        const sellTax = parseFloat(tokenData.sell_tax || '0');
        if (buyTax > 10) flags.push(`Buy Tax ${buyTax}%`);
        if (sellTax > 10) flags.push(`Sell Tax ${sellTax}%`);
        return {
          name: tokenData.token_name || null,
          symbol: tokenData.token_symbol || null,
          flags,
          holders: parseInt(tokenData.holder_count || '0'),
          totalSupply: tokenData.total_supply || null,
          creator: tokenData.creator_address || null,
          owner: tokenData.owner_address || null,
          decimals: tokenData.decimals || null,
          buyTax: buyTax,
          sellTax: sellTax,
          is_risky: flags.length > 0,
          raw: tokenData
        };
      } catch { return null; }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const raw = input.value.trim();
      if (!raw) { input.focus(); return; }

      result.style.display = 'block';
      resultCard.className = 'scam-result-card';
      resultCard.style.opacity = '0';
      btnText.style.display = 'none';
      btnSpinner.style.display = 'inline-block';
      btn.disabled = true;

      await new Promise(r => setTimeout(r, 200));
      const cleaned = normalizeInput(raw);

      if (cleaned.length < 4) {
        btnText.style.display = 'inline';
        btnSpinner.style.display = 'none';
        btn.disabled = false;
        resultCard.className = 'scam-result-card scam-result-warning';
        resultIcon.textContent = '⚠️';
        resultIconWrap.style.background = 'rgba(245, 158, 11, 0.12)';
        resultTitle.textContent = 'Input Tidak Valid';
        resultDetail.textContent = 'Masukkan domain atau address yang valid.';
        resultCard.style.opacity = '1';
        result.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      const addrType = isAddress(cleaned);
      const matches = checkBlacklist(cleaned, addrType);
      let goPlusResult = null;
      if (addrType === 'evm' || addrType === 'sol' || addrType === 'bsc') {
        const chainId = CHAIN_MAP[addrType] || 1;
        goPlusResult = await checkGoPlus(cleaned, chainId, addrType === 'sol', raw.trim());
      }

      btnText.style.display = 'inline';
      btnSpinner.style.display = 'none';
      btn.disabled = false;

      const isScam = matches && matches.length > 0;
      const goPlusRisky = goPlusResult && goPlusResult.is_risky;

      if (isScam || goPlusRisky) {
        let html = '';
        resultCard.className = 'scam-result-card scam-result-scam';
        if (isScam) {
          const sources = [...new Set(matches.flatMap(m => m.source.split(', ')))];
          const sourceBadges = sources.map(s => {
            const meta = SOURCE_META[s] || { icon: '\uD83D\uDCCB', label: s };
            return `<span class="src-badge">${meta.icon} ${meta.label}</span>`;
          }).join(' ');
          html += `<p><strong>Terdaftar sebagai scam</strong> di database kami:</p><div class="src-badges">${sourceBadges}</div>${matches.length > 1 && !addrType ? `<small>(${matches.length} varian terkait)</small>` : ''}`;
        }
        if (goPlusRisky) {
          const flagBadges = goPlusResult.flags.map(f => `<span class="flag-badge flag-bad">${f}</span>`).join(' ');
          html += `<p style="margin-top: ${isScam ? '0.75rem' : '0'}; margin-bottom: 0;"><strong>⚠️ Go+ Security:</strong> Token ini terdeteksi berbahaya</p><div class="src-badges">${flagBadges}</div>`;
        }
        resultIcon.textContent = '⚠️';
        resultIconWrap.style.background = 'rgba(239, 68, 68, 0.12)';
        resultTitle.textContent = '⚠️ SCAM / BERBAHAYA';
        resultDetail.innerHTML = html;
      } else {
        resultCard.className = 'scam-result-card scam-result-aman';
        resultIcon.textContent = '✅';
        resultIconWrap.style.background = 'rgba(16, 185, 129, 0.12)';
        resultTitle.textContent = '✅ Aman - Tidak Terdaftar';
        let html = addrType ? 'Address ini <strong>tidak terdaftar</strong> sebagai scam di database kami.' : 'Domain ini <strong>tidak terdaftar</strong> sebagai scam di database kami.';
        if (goPlusResult) {
          const r = goPlusResult;
          const nameInfo = r.name ? `<strong>${r.name}</strong>${r.symbol ? ` ($${r.symbol})` : ''}` : '';
          const holderInfo = r.holders > 0 ? ` | ${r.holders.toLocaleString()} holders` : '';
          const supplyInfo = r.totalSupply ? ` | Supply: ${r.totalSupply}` : '';
          const taxInfo = (r.buyTax > 0 || r.sellTax > 0) ? ` | Buy Tax: ${r.buyTax}% Sell Tax: ${r.sellTax}%` : '';
          const flagCount = r.flags.length > 0 ? ` (${r.flags.length} flags)` : '';
          html += `<br><small>⚡ Go+: ${nameInfo}${holderInfo}${supplyInfo}${taxInfo}${flagCount}</small>`;
        }
        html += `<br><small>Tetap verifikasi sebelum transaksi.</small>`;
        resultDetail.innerHTML = html;
      }
      resultCard.style.opacity = '1';
      result.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') form.dispatchEvent(new Event('submit'));
    });
  })();

