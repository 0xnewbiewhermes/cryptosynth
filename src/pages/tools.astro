<script>
  // ===== TAB SWITCHING =====
  (function() {
    const tabs = document.querySelectorAll('.tools-tab');
    const panels = {
      tracker: document.getElementById('panel-tracker'),
      scam: document.getElementById('panel-scam'),
    };

    function getTabFromUrl() {
      const params = new URLSearchParams(window.location.search);
      return params.get('tab') || 'tracker';
    }

    function switchTab(tabId, updateUrl) {
      tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === tabId));
      Object.keys(panels).forEach(id => {
        panels[id].classList.toggle('active', id === tabId);
      });
      if (updateUrl) {
        const url = new URL(window.location);
        url.searchParams.set('tab', tabId);
        window.history.replaceState({}, '', url);
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => switchTab(tab.dataset.tab, true));
    });

    // Activate tab from URL (or default)
    switchTab(getTabFromUrl(), false);
  })();

  // ===== TRACKER JS =====
  (function() {
    const pills = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('.airdrop-card');
    const searchInput = document.getElementById('trackerSearch');
    const countEl = document.getElementById('visibleCount');
    if (!pills.length || !cards.length) return;

    function getCategoryFromUrl() {
      const params = new URLSearchParams(window.location.search);
      return params.get('category') || 'all';
    }

    let activeCategory = getCategoryFromUrl();

    function updateCount() {
      const visible = document.querySelectorAll('.airdrop-card:not([style*="display: none"])').length;
      if (countEl) countEl.textContent = String(visible);
    }

    function filterCards() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      cards.forEach(card => {
        const el = card;
        const cat = el.dataset.category;
        const text = el.textContent?.toLowerCase() || '';
        const catMatch = activeCategory === 'all' || cat === activeCategory;
        const searchMatch = !query || text.includes(query);
        el.style.display = (catMatch && searchMatch) ? '' : 'none';
      });
      updateCount();
    }

    function setActivePill(category) {
      pills.forEach(p => {
        p.classList.toggle('active', (p.dataset.category || 'all') === category);
      });
      activeCategory = category;
      filterCards();
      const url = new URL(window.location);
      if (category === 'all') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', category);
      }
      window.history.replaceState({}, '', url);
    }

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        setActivePill(pill.dataset.category || 'all');
      });
    });

    searchInput?.addEventListener('input', filterCards);

    // Restore category from URL
    if (activeCategory !== 'all') {
      setActivePill(activeCategory);
    }

    // Card expand with keyboard support
    document.querySelectorAll('.card-summary').forEach(summary => {
      summary.setAttribute('tabindex', '0');
      summary.setAttribute('role', 'button');

      function toggleCard(e) {
        if (e.type === 'keydown' && e.key !== 'Enter' && e.key !== ' ') return;
        if (e.type === 'keydown') e.preventDefault();
        if (e.target.closest('.card-project-link')) return;
        const idx = summary.dataset.idx;
        const detail = document.getElementById('detail-' + idx);
        const card = summary.closest('.airdrop-card');
        if (detail && card) {
          const isOpen = detail.classList.contains('open');
          document.querySelectorAll('.card-detail.open').forEach(d => d.classList.remove('open'));
          document.querySelectorAll('.airdrop-card.expanded').forEach(c => c.classList.remove('expanded'));
          if (!isOpen) {
            detail.classList.add('open');
            card.classList.add('expanded');
          }
        }
      }

      summary.addEventListener('click', toggleCard);
      summary.addEventListener('keydown', toggleCard);
    });
  })();

  // ===== SCAM CHECKER JS =====
  (function() {
    const dataUrl = '/data/scam-alerts.json';
    let scamData = [];
    const form = document.getElementById('checkForm');
    const input = document.getElementById('checkInput');
    const result = document.getElementById('checkResult');
    const resultCard = document.getElementById('resultCard');
    const resultIconWrap = document.getElementById('resultIconWrap');
    const resultIcon = document.getElementById('resultIcon');
    const resultTitle = document.getElementById('resultTitle');
    const resultDetail = document.getElementById('resultDetail');
    const stats = document.getElementById('scamStats');
    const statsText = document.getElementById('statsText');
    const btnText = document.getElementById('btnText');
    const btnSpinner = document.getElementById('btnSpinner');
    const btn = document.getElementById('checkBtn');
    if (!form) return;

    const SOURCE_META = {
      'ScamSniffer': { icon: '🛡️', label: 'ScamSniffer' },
      'jarelllama': { icon: '🚫', label: 'jarelllama' },
      'phishdestroy': { icon: '🔥', label: 'phishdestroy' }
    };

    // Load data with sessionStorage cache
    const cacheKey = 'scam_db';
    const cached = sessionStorage.getItem(cacheKey);
    if (cached) {
      try {
        scamData = JSON.parse(cached);
        showStats(scamData);
        enableBtn();
        return;
      } catch {}
    }

    fetch(dataUrl + '?v=' + Date.now())
      .then(r => r.json())
      .then(data => {
        scamData = data;
        try { sessionStorage.setItem(cacheKey, JSON.stringify(data)); } catch {}
        showStats(data);
        enableBtn();
      })
      .catch(() => {
        if (statsText) statsText.innerHTML = '❌ Gagal memuat database';
        if (stats) stats.style.color = '#EF4444';
        btn.disabled = false;
        btnText.textContent = 'Coba Lagi';
        btnSpinner.style.display = 'none';
        btn.title = '';
      });

    function enableBtn() {
      btn.disabled = false;
      btnText.textContent = 'Periksa';
      btnSpinner.style.display = 'none';
      btn.title = '';
    }

    function showStats(data) {
      const counts = {};
      data.forEach(d => {
        d.source.split(', ').forEach(s => { counts[s] = (counts[s] || 0) + 1; });
      });
      const parts = [];
      if (counts['ScamSniffer']) parts.push(`🛡️ ${(counts['ScamSniffer']).toLocaleString('id-ID')}`);
      if (counts['jarelllama']) parts.push(`🚫 ${(counts['jarelllama']).toLocaleString('id-ID')}`);
      if (counts['phishdestroy']) parts.push(`🔥 ${(counts['phishdestroy']).toLocaleString('id-ID')}`);
      if (statsText) statsText.innerHTML = '✅ Database siap &bull; ' + parts.join(' &bull; ');
    }

    function isAddress(input) {
      if (/^0x[a-f0-9]{40}$/i.test(input)) return 'evm';
      if (/^(bc1|[13])[a-zA-Z0-9]{25,62}$/.test(input)) return 'btc';
      if (/^[1-9A-HJ-NP-Za-km-z]{32,44}$/.test(input) && !input.includes('.')) return 'sol';
      return false;
    }

    const CYRILLIC_MAP = {
      "\u0430":"a","\u0435":"e","\u043e":"o","\u0440":"p","\u0441":"c","\u0443":"y","\u0445":"x",
      "\u0410":"A","\u0412":"B","\u0415":"E","\u041a":"K","\u041c":"M","\u041d":"H","\u041e":"O",
      "\u0420":"P","\u0421":"C","\u0422":"T"
    };
    const INVISIBLE_SET = new Set(["\u200b","\u200c","\u200d","\u200e","\u200f","\u2060","\u00ad","\u034f","\u180e","\u2800","\u3164","\uffa0"]);
    const RISKY_TLDS = [".tk",".ml",".ga",".cf",".gq",".xyz",".top",".club",".work",".buzz",".icu",".cam",".rest"];

    function detectHomograph(domain) {
      const suspicious = [];
      let hasCyrillic = false, hasLatin = false;
      const invisible = [];

      for (let i = 0; i < domain.length; i++) {
        const ch = domain[i];
        const code = ch.codePointAt(0);
        if (ch === "." || ch === "-") continue;
        if (code >= 0x0400 && code <= 0x052F) {
          hasCyrillic = true;
          suspicious.push({ pos: i, char: ch, code: "U+" + code.toString(16).toUpperCase().padStart(4,"0"), looksLike: CYRILLIC_MAP[ch] || "?" });
        } else if (code >= 0x0041 && code <= 0x007A) {
          hasLatin = true;
        }
        if (INVISIBLE_SET.has(ch)) {
          invisible.push({ pos: i, code: "U+" + code.toString(16).toUpperCase().padStart(4,"0") });
        }
      }

      let punycode = null;
      try {
        const hasNonAscii = [...domain].some(c => c.codePointAt(0) > 127);
        if (hasNonAscii) {
          const url = new URL("http://" + domain);
          punycode = url.hostname;
        }
      } catch {}

      const mixedScript = hasCyrillic && hasLatin;
      const isIDN = punycode && punycode !== domain && punycode.includes("xn--");

      let risk = "low";
      const reasons = [];
      if (suspicious.length > 0) { risk = "high"; reasons.push(suspicious.length + " Cyrillic lookalike"); }
      if (mixedScript) { risk = "critical"; reasons.push("Mixed Cyrillic+Latin (homograph attack)"); }
      if (invisible.length > 0) { risk = "critical"; reasons.push(invisible.length + " invisible/zero-width chars"); }
      if (isIDN) reasons.push("IDN punycode: " + punycode);

      const tld = RISKY_TLDS.find(t => domain.endsWith(t));

      return { suspicious, invisible, mixedScript, isIDN, punycode, risk, reasons, riskyTld: tld || null };
    }

    function normalizeInput(input) {
      let d = input.trim().toLowerCase();
      for (const prefix of ["http://", "https://", "www.", "hxxp://", "hxxps://", "ftp://"]) {
        if (d.startsWith(prefix)) d = d.slice(prefix.length);
      }
      d = d.replace(/\/+$/, "").replace(/\/$/, "");
      return d;
    }

    function checkBlacklist(input, addrType) {
      if (!input || !scamData.length) return null;
      if (addrType) {
        const match = scamData.find(d => d.type === 'address' && d.key === input);
        return match ? [match] : null;
      }
      const matches = scamData.filter(d =>
        d.type === 'domain' && (
          d.key === input ||
          d.key.endsWith('.' + input) ||
          input.includes(d.key)
        )
      );
      return matches.length > 0 ? matches : null;
    }

    const CHAIN_MAP = {
      evm: 1, bsc: 56, sol: 101, polygon: 137, avalanche: 43114,
      arbitrum: 42161, optimism: 10, base: 8453
    };

    async function checkGoPlus(address, chainId, isSolana, rawInput) {
      try {
        const solParam = isSolana ? '&solana=1' : '';
        const resp = await fetch(
          `/api/goplus?chain=${chainId}&address=${encodeURIComponent(address)}${solParam}`,
          { signal: AbortSignal.timeout(10000) }
        );
        const data = await resp.json();
        const result = data.result || {};
        // Solana preserves original case; try lookupKey, then lowercased, then raw input
        const lookupKey = isSolana ? rawInput : address.toLowerCase();
        const tokenData = result[lookupKey] || result[address.toLowerCase()] || result[address];
        if (!tokenData) return null;
        const flags = [];
        if (tokenData.is_honeypot === '1') flags.push('Honeypot');
        if (tokenData.is_blacklisted === '1') flags.push('Blacklist');
        if (tokenData.cannot_buy === '1') flags.push('Cannot Buy');
        if (tokenData.cannot_sell_all === '1') flags.push('Cannot Sell All');
        if (tokenData.trading_cooldown === '1') flags.push('Trading Cooldown');
        if (tokenData.anti_whale_modifiable === '1') flags.push('Anti-Whale Modifiable');
        if (tokenData.can_take_back_ownership === '1') flags.push('Ownership Can Be Taken');
        if (tokenData.owner_change_balance === '1') flags.push('Owner Can Change Balance');
        if (tokenData.hidden_owner === '1') flags.push('Hidden Owner');
        if (tokenData.selfdestruct === '1') flags.push('Self-Destruct');
        if (tokenData.external_call === '1') flags.push('External Call');
        if (tokenData.is_airdrop_scam === '1') flags.push('Airdrop Scam');
        if (tokenData.trust_list === '0' && tokenData.is_blacklisted !== '1') flags.push('Not on Trust List');
        const buyTax = parseFloat(tokenData.buy_tax || '0');
        const sellTax = parseFloat(tokenData.sell_tax || '0');
        if (buyTax > 10) flags.push(`Buy Tax ${buyTax}%`);
        if (sellTax > 10) flags.push(`Sell Tax ${sellTax}%`);
        return {
          name: tokenData.token_name || null,
          symbol: tokenData.token_symbol || null,
          flags,
          holders: parseInt(tokenData.holder_count || '0'),
          totalSupply: tokenData.total_supply || null,
          creator: tokenData.creator_address || null,
          owner: tokenData.owner_address || null,
          decimals: tokenData.decimals || null,
          buyTax: buyTax,
          sellTax: sellTax,
          is_risky: flags.length > 0,
          raw: tokenData
        };
      } catch { return null; }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const raw = input.value.trim();
      if (!raw) { input.focus(); return; }

      result.style.display = 'block';
      resultCard.className = 'scam-result-card';
      resultCard.style.opacity = '0';
      btnText.style.display = 'none';
      btnSpinner.style.display = 'inline-block';
      btn.disabled = true;
      try {

      await new Promise(r => setTimeout(r, 200));
      const cleaned = normalizeInput(raw);

      if (cleaned.length < 4) {
        btnText.style.display = 'inline';
        btnSpinner.style.display = 'none';
        btn.disabled = false;
        resultCard.className = 'scam-result-card scam-result-warning';
        resultIcon.textContent = '⚠️';
        resultIconWrap.style.background = 'rgba(245, 158, 11, 0.12)';
        resultTitle.textContent = 'Input Tidak Valid';
        resultDetail.textContent = 'Masukkan domain atau address yang valid.';
        resultCard.style.opacity = '1';
        result.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      const addrType = isAddress(cleaned);
      // Check for homograph attack FIRST (client-side, instant)
      const hg = detectHomograph(cleaned);
      if (hg.risk === 'critical' || hg.risk === 'high') {
        let hgHtml = '<p><strong>🚨 Homograph Attack Terdeteksi!</strong></p>';
        hgHtml += '<div class="src-badges">';
        hg.reasons.forEach(r => { hgHtml += '<span class="flag-badge flag-bad">' + r + '</span>'; });
        hgHtml += '</div>';
        if (hg.suspicious.length > 0) {
          hgHtml += '<p style="margin-top:0.5rem;margin-bottom:0;"><small>Karakter Cyrillic yang mirip Latin:</small></p><div class="homograph-chars">';
          hg.suspicious.forEach(c => {
            hgHtml += '<span class="hg-char"><code>' + c.char + '</code> (' + c.code + ') → <strong>' + c.looksLike + '</strong></span>';
          });
          hgHtml += '</div>';
        }
        if (hg.punycode) {
          hgHtml += '<p style="margin-top:0.5rem;margin-bottom:0;"><small>Punycode: <code>' + hg.punycode + '</code></small></p>';
        }
        if (hg.riskyTld) {
          hgHtml += '<p style="margin-top:0.35rem;margin-bottom:0;"><small>TLD berisiko tinggi: <code>' + hg.riskyTld + '</code></small></p>';
        }
        hgHtml += '<p style="margin-top:0.5rem;margin-bottom:0;"><small>Jangan kunjungi domain ini. Kemungkinan besar phishing.</small></p>';
        resultCard.className = 'scam-result-card scam-result-scam';
        resultIcon.textContent = '🚨';
        resultIconWrap.style.background = 'rgba(239, 68, 68, 0.12)';
        resultTitle.textContent = '🚨 HOMOGRAPH ATTACK';
        resultDetail.innerHTML = hgHtml;
        resultCard.style.opacity = '1';
        btnText.style.display = 'inline';
        btnSpinner.style.display = 'none';
        btn.disabled = false;
        result.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      if (hg.riskyTld) {
        // Show TLD warning but continue to blacklist check
        // (will be included in final result if scam, or shown as note if clean)
      }

      const matches = checkBlacklist(cleaned, addrType);
      let goPlusResult = null;
      let threatResult = null;

      // Run GoPlus + threat API in parallel
      const promises = [];
      if (addrType === 'evm' || addrType === 'sol' || addrType === 'bsc') {
        const chainId = CHAIN_MAP[addrType] || 1;
        promises.push(checkGoPlus(cleaned, chainId, addrType === 'sol', raw.trim()).then(r => { goPlusResult = r; }));
      }
      if (!addrType) {
        // Domain input: check threat APIs
        promises.push(
          fetch(`/api/threat-check?domain=${encodeURIComponent(cleaned)}`, { signal: AbortSignal.timeout(15000) })
            .then(r => r.json())
            .then(d => { threatResult = d; })
            .catch(() => {})
        );
      }
      await Promise.all(promises);

      btnText.style.display = 'inline';
      btnSpinner.style.display = 'none';
      btn.disabled = false;

      const isScam = matches && matches.length > 0;
      const goPlusRisky = goPlusResult && goPlusResult.is_risky;
      const threatRisky = threatResult && (threatResult.overallRisk === 'critical' || threatResult.overallRisk === 'high');
      const threatChecks = threatResult?.checks || [];
      const threatMalicious = threatChecks.filter(c => c.risk === 'critical' || c.risk === 'high' && !c.skipped);

      if (isScam || goPlusRisky || threatRisky) {
        let html = '';
        resultCard.className = 'scam-result-card scam-result-scam';
        if (isScam) {
          const sources = [...new Set(matches.flatMap(m => m.source.split(', ')))];
          const sourceBadges = sources.map(s => {
            const meta = SOURCE_META[s] || { icon: '\uD83D\uDCCB', label: s };
            return `<span class="src-badge">${meta.icon} ${meta.label}</span>`;
          }).join(' ');
          html += `<p><strong>Terdaftar sebagai scam</strong> di database lokal:</p><div class="src-badges">${sourceBadges}</div>${matches.length > 1 && !addrType ? `<small>(${matches.length} varian terkait)</small>` : ''}`;
        }
        // Threat API results
        if (threatMalicious.length > 0) {
          html += `<p style="margin-top: ${isScam ? '0.75rem' : '0'}; margin-bottom: 0;"><strong>⚠️ Terdeteksi oleh threat intelligence:</strong></p><div class="src-badges">`;
          threatMalicious.forEach(c => {
            const riskColor = c.risk === 'critical' ? 'flag-bad' : 'flag-warn';
            let detail = c.source;
            if (c.malicious !== undefined) detail += ` (${c.malicious} engine)`;
            if (c.threats?.length) detail += `: ${c.threats.join(', ')}`;
            if (c.found !== undefined && c.found) detail += ' ✓ Listed';
            html += `<span class="flag-badge ${riskColor}">${detail}</span>`;
          });
          html += `</div>`;
        }
        if (goPlusRisky) {
          const flagBadges = goPlusResult.flags.map(f => `<span class="flag-badge flag-bad">${f}</span>`).join(' ');
          html += `<p style="margin-top: ${isScam || threatRisky ? '0.75rem' : '0'}; margin-bottom: 0;"><strong>⚠️ Go+ Security:</strong> Token ini terdeteksi berbahaya</p><div class="src-badges">${flagBadges}</div>`;
        }
        resultIcon.textContent = '⚠️';
        resultIconWrap.style.background = 'rgba(239, 68, 68, 0.12)';
        resultTitle.textContent = '⚠️ SCAM / BERBAHAYA';
        resultDetail.innerHTML = html;
      } else {
        resultCard.className = 'scam-result-card scam-result-aman';
        resultIcon.textContent = '✅';
        resultIconWrap.style.background = 'rgba(16, 185, 129, 0.12)';
        resultTitle.textContent = '✅ Aman - Tidak Terdaftar';
        let html = addrType ? 'Address ini <strong>tidak terdaftar</strong> sebagai scam.' : 'Domain ini <strong>tidak terdaftar</strong> sebagai scam.';
        if (goPlusResult) {
          const r = goPlusResult;
          const nameInfo = r.name ? `<strong>${r.name}</strong>${r.symbol ? ` ($${r.symbol})` : ''}` : '';
          const holderInfo = r.holders > 0 ? ` | ${r.holders.toLocaleString()} holders` : '';
          const supplyInfo = r.totalSupply ? ` | Supply: ${r.totalSupply}` : '';
          const taxInfo = (r.buyTax > 0 || r.sellTax > 0) ? ` | Buy Tax: ${r.buyTax}% Sell Tax: ${r.sellTax}%` : '';
          const flagCount = r.flags.length > 0 ? ` (${r.flags.length} flags)` : '';
          html += `<br><small>⚡ Go+: ${nameInfo}${holderInfo}${supplyInfo}${taxInfo}${flagCount}</small>`;
        }
        // Show clean threat API results
        if (threatResult) {
          const cleanSources = threatChecks.filter(c => c.risk === 'low' && !c.skipped);
          if (cleanSources.length > 0) {
            html += `<br><small>🔍 Bersih di: ${cleanSources.map(c => c.source).join(', ')}</small>`;
          }
          const skippedSources = threatChecks.filter(c => c.skipped);
          if (skippedSources.length > 0) {
            html += `<br><small style="opacity:0.6">⏸️ ${skippedSources.length} source belum dikonfigurasi (butuh API key)</small>`;
          }
        }
        if (hg.riskyTld) {
          html += `<br><small>⚠️ TLD <code>${hg.riskyTld}</code> sering digunakan scammer. Hati-hati.</small>`;
        }
        html += `<br><small>Tetap verifikasi sebelum transaksi.</small>`;
        resultDetail.innerHTML = html;
      }
      resultCard.style.opacity = '1';
      result.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch (err) {
      console.error("Scam error:", err);
      resultCard.className = 'scam-result-card scam-result-warning';
      resultCard.style.opacity = '1';
      resultIcon.textContent = '❌';
      resultIconWrap.style.background = 'rgba(239, 68, 68, 0.12)';
      resultTitle.textContent = 'Gagal Memeriksa';
      resultDetail.innerHTML = '<p>Terjadi kesalahan saat memeriksa. Coba lagi atau periksa koneksi internet.</p>';
      result.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } finally {
      btnText.style.display = "inline";
      btnSpinner.style.display = "none";
      btn.disabled = false;
    }
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') form.dispatchEvent(new Event('submit'));
    });
  })();

