---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404: Block Not Found — CryptoSynth.id" description="Halaman yang kamu cari tidak ditemukan. Mungkin transaksinya revert.">
  <section class="error-page" transition:animate="fade">
    <div class="container">
      <div class="error-content">
        <div class="error-icon">
          <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" stroke="var(--primary)" fill="transparent" stroke-opacity="0.3"/>
            <line x1="15" y1="9" x2="9" y2="15" stroke="var(--primary)"/>
            <line x1="9" y1="9" x2="15" y2="15" stroke="var(--primary)"/>
            <path d="M12 6v2" stroke="var(--primary)"/>
            <path d="M12 12v4" stroke="var(--primary)"/>
            <path d="M10 18h4" stroke="var(--primary)"/>
          </svg>
        </div>
        <div class="error-code">404</div>
        <h1>Block Tidak Ditemukan</h1>
        <p class="error-subtitle">Transaksi kamu mungkin <strong>revert</strong>, atau halaman ini udah <strong>dihapus</strong> dari state tree.</p>

        <div class="error-details">
          <div class="error-detail-item">
            <span class="error-label">Tx Hash</span>
            <span class="error-value error-hash">0x0000...0000</span>
          </div>
          <div class="error-detail-item">
            <span class="error-label">Status</span>
            <span class="error-value error-status">❌ Reverted</span>
          </div>
          <div class="error-detail-item">
            <span class="error-label">RPC Error</span>
            <span class="error-value error-rpc">execution reverted: page not found</span>
          </div>
        </div>

        <div class="error-actions">
          <a href="/" class="btn btn-primary">← Kembali ke Beranda</a>
          <a href="/berita" class="btn btn-outline">Baca Berita Terbaru</a>
          <a href="/search" class="btn btn-ghost">🔍 Cari Artikel</a>
        </div>

        <div class="error-fun">
          <p class="error-fun-label">Atau coba action lain:</p>
          <div class="error-fun-links">
            <a href="/airdrop"><span class="fun-icon">🪂</span> Claim Airdrop</a>
            <a href="/scam-check"><span class="fun-icon">🔍</span> Cek Scam</a>
            <a href="/category/defi"><span class="fun-icon">🏦</span> DeFi</a>
            <a href="/category/tutorial"><span class="fun-icon">📖</span> Tutorial</a>
          </div>
          <p class="error-console">console.log(<span class="error-string">"Gas: 404, status: reverted — mungkin lo salah alamat."</span>);</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .error-page {
    min-height: 65vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 0;
  }

  .error-content { max-width: 520px; }

  .error-icon {
    margin-bottom: 0.75rem;
    display: inline-block;
    animation: errorFloat 3s ease-in-out infinite;
  }

  @keyframes errorFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .error-code {
    font-family: var(--font-display);
    font-size: 6rem;
    font-weight: 800;
    letter-spacing: -0.08em;
    line-height: 1;
    color: var(--primary);
    margin-bottom: 0.25rem;
  }

  .error-content h1 {
    font-size: 1.6rem;
    margin-bottom: 0.5rem;
  }

  .error-subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .error-subtitle strong { color: var(--text-primary); }

  /* Error Details — crypto terminal style */
  .error-details {
    background: var(--bg-surface);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    text-align: left;
    font-size: 0.82rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    box-shadow: var(--shadow-card);
  }

  .error-detail-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .error-label {
    font-weight: 600;
    color: var(--text-muted);
    min-width: 72px;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .error-value { color: var(--text-primary); font-family: 'JetBrains Mono', monospace; font-size: 0.82rem; }
  .error-hash { color: var(--text-muted); }
  .error-status { color: #DC2626; }
  .error-rpc { color: var(--text-secondary); font-style: italic; }

  .error-actions {
    display: flex;
    gap: 0.65rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.6rem 1.2rem;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-ghost:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
    border-color: var(--border);
  }

  /* Fun section */
  .error-fun { border-top: 1px solid var(--border); padding-top: 1.5rem; }

  .error-fun-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .error-fun-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .error-fun-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.9rem;
    background: var(--bg-hover);
    border-radius: var(--radius-pill);
    font-size: 0.82rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .error-fun-links a:hover {
    background: var(--primary);
    color: white;
  }

  .fun-icon { font-size: 1rem; }

  .error-console {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    color: var(--text-muted);
    background: var(--bg-elevated);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    display: inline-block;
    border: 1px solid var(--border);
  }

  .error-string { color: #059669; }

  @media (max-width: 600px) {
    .error-code { font-size: 4.5rem; }
    .error-content h1 { font-size: 1.3rem; }
    .error-details { font-size: 0.75rem; }
    .error-label { min-width: 60px; }
  }
</style>
