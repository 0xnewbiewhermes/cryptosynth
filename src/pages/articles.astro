---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { relativeTime } from '../utils/relativeTime';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const categories = ['Semua', 'Berita', 'Airdrop', 'DeFi', 'Funding', 'Tutorial'];
---

<BaseLayout title="Semua Artikel - CryptoSynth.id" description="Seluruh artikel berita crypto, DeFi, airdrop, dan tutorial yang telah dipublikasikan oleh CryptoSynth.">
  <div class="page-hero">
    <div class="container">
      <h1>Semua Artikel</h1>
      <p>Seluruh artikel yang telah dipublikasikan oleh tim redaksi CryptoSynth.</p>
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width: 800px;">
      <div class="category-filter" style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 2rem;">
      {categories.map((cat) => (
        <a
          href={cat === 'Semua' ? '/articles' : `/category/${cat.toLowerCase()}`}
          class={`filter-btn ${cat === 'Semua' ? 'active' : ''}`}
          style={`
            padding: 0.4rem 1rem;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            ${cat === 'Semua'
              ? 'background: var(--primary); color: #fff;'
              : 'background: var(--bg-surface); color: var(--text-muted); border: 1px solid var(--border);'}
          `}
        >
          {cat}
        </a>
      ))}
    </div>

    <!-- Articles Grid -->
    <div class="articles-grid">
      {posts.map((post) => (
        <article class="article-card">
          <div class="card-image">
            <picture>
              <source srcset={`/images/hero/${post.id}.webp`} type="image/webp" />
              <img src={`/images/hero/${post.id}.png`} alt={post.data.title} width="1200" height="630" loading="lazy" />
            </picture>
          </div>
          <div class="card-content">
            <div class="card-tags">
              <a href={`/category/${post.data.category?.toLowerCase() || 'berita'}`} class="card-category">
                {post.data.category || 'Berita'}
              </a>
              {(post.data.tags || []).slice(0, 2).map((tag) => (
                <span class="card-tag">#{tag}</span>
              ))}
            </div>
            <h3 class="card-title">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h3>
            <p class="card-excerpt">{post.data.excerpt || post.data.description}</p>
            <div class="card-meta">
              <span class="card-relative-time" data-pubdate={new Date(post.data.pubDate).toISOString()}>{relativeTime(post.data.pubDate)}</span>
              <span class="card-date-sep">·</span>
              <span>{new Date(post.data.pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' })}</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    {posts.length === 0 && (
      <div style="text-align: center; padding: 4rem 0; color: var(--text-muted);">
        <p style="font-size: 1.1rem;">Belum ada artikel yang dipublikasikan.</p>
      </div>
    )}

    <div style="text-align: center; padding: 2rem 0 0; color: var(--text-muted); font-size: 0.85rem;">
      Menampilkan {posts.length} artikel
    </div>
    </div>
  </section>
</BaseLayout>
