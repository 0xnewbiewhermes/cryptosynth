---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Parse FAQ from flat string format: "Q1;;A1;;Q2;;A2;;Q3;;A3"
function parseFaq(faqStr: string): { question: string; answer: string }[] {
  if (!faqStr || faqStr.trim() === '' || faqStr === '[]') return [];
  const parts = faqStr.split(';;');
  const items: { question: string; answer: string }[] = [];
  for (let i = 0; i < parts.length - 1; i += 2) {
    const q = parts[i]?.trim();
    const a = parts[i + 1]?.trim();
    if (q && a) items.push({ question: q, answer: a });
  }
  return items;
}
const faqItems = parseFaq(post.data.faq || '');

const formattedDate = new Date(post.data.pubDate).toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Asia/Jakarta',
});

// Date with WIB timezone offset for structured data
function toWIB(date: Date): string {
  const wib = new Date(date.getTime() + 7 * 60 * 60 * 1000);
  return wib.toISOString().replace('Z', '+07:00');
}
const publishDateWIB = post.data.pubDate ? toWIB(new Date(post.data.pubDate)) : undefined;
const modifiedDateWIB = post.data.updatedDate ? toWIB(new Date(post.data.updatedDate)) : publishDateWIB;

// OG image path
const ogImage = `/images/og/${post.id}.png`;
// Hero image path
const heroImage = `/images/hero/${post.id}.png`;

// Related articles: score by shared tags + same category, pick top 3
const allPosts = await getCollection('blog');
const currentTags = new Set(post.data.tags || []);
const currentCategory = post.data.category;
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => {
    const sharedTags = (p.data.tags || []).filter((t) => currentTags.has(t)).length;
    const sameCategory = p.data.category === currentCategory ? 1 : 0;
    return { post: p, score: sharedTags * 2 + sameCategory };
  })
  .sort((a, b) => b.score - a.score || new Date(b.post.data.pubDate).getTime() - new Date(a.post.data.pubDate).getTime())
  .slice(0, 3)
  .map((r) => r.post);

const shareUrl = `https://cryptosynth.id/blog/${post.id}`;
const shareText = post.data.title;
const shortDate = new Date(post.data.pubDate).toLocaleDateString('id-ID', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'Asia/Jakarta' });
const readTime = post.data.readingTime || Math.max(3, Math.ceil((post.body?.length || 1500) / 1000));
const wordCount = post.body?.split(/\s+/).length || 0;

// Terminal breadcrumb path
const termPath = `~/cryptosynth/catatan/${post.id}.md`;
---

<BaseLayout title={post.data.title} description={post.data.excerpt || post.data.description} image={ogImage} type="article" publishDate={publishDateWIB} modifiedDate={modifiedDateWIB} author={post.data.author || 'Gideon'} category={post.data.category} tags={post.data.tags} faq={faqItems} terminalPath={termPath}>
  <article class="article-container">
    <!-- Back link -->
    <a href="/" class="article-back">← kembali ke daftar</a>

    <!-- Tag -->
    <div class="article-tag-label">
      {(post.data.tags || []).map((tag) => `#${tag}`).join(' · ')}
    </div>

    <!-- Title -->
    <h1 class="article-title">{post.data.title}</h1>

    <!-- Meta -->
    <div class="article-meta-row">
      <span class="meta-item"><span class="meta-label">author:</span> {post.data.author || 'Gideon'}</span>
      <span class="meta-item"><span class="meta-label">date:</span> {shortDate}</span>
      <span class="meta-item"><span class="meta-label">read:</span> {readTime}&nbsp;min</span>
      <span class="meta-item"><span class="meta-label">words:</span> ~{wordCount.toLocaleString()}</span>
    </div>

    <!-- Hero image (if exists) -->
    <div class="article-hero" style="margin-bottom:1.75rem">
      <picture>
        <source srcset={heroImage.replace('.png', '.webp')} type="image/webp" />
        <img src={heroImage} alt={post.data.title} width="1059" height="556" loading="eager" fetchpriority="high" style="width:100%;height:auto;display:block" />
      </picture>
    </div>

    <!-- Article Body -->
    <div class="article-body">
      <Content />
    </div>

    <!-- Tags -->
    {post.data.tags && post.data.tags.length > 0 && (
      <div class="tags-row" style="margin-top:2rem">
        {post.data.tags.map((tag) => (
          <a href={`/articles?tag=${tag}`} class="tag-chip">#{tag}</a>
        ))}
      </div>
    )}

    <!-- Share Section -->
    <div class="share-section" style="margin-top:1.5rem;display:flex;gap:0.75rem;align-items:center">
      <span style="font-size:0.62rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.1em">share:</span>
      <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText + ' ' + shareUrl)}`} target="_blank" rel="noopener noreferrer" class="tag-chip">WhatsApp</a>
      <a href={`https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareText)}`} target="_blank" rel="noopener noreferrer" class="tag-chip">Telegram</a>
      <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer" class="tag-chip">X</a>
    </div>

    <!-- FAQ Section -->
    <FaqSection items={faqItems} />

    <!-- Related Articles -->
    {relatedPosts.length > 0 && (
      <div class="article-footer">
        <div class="related-section">
          <h3>Related Catatan</h3>
          {relatedPosts.map((rp, i) => (
            <a href={`/blog/${rp.id}`} class="related-item">
              <span class="related-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <div class="related-tag">
                  {(rp.data.tags || []).slice(0, 2).map((t) => `#${t}`).join(' · ')}
                </div>
                <div class="related-title">{rp.data.title}</div>
                <div class="related-date">
                  {new Date(rp.data.pubDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Jakarta' })}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </article>

  <!-- Article Nav (prev/next) -->
  <div class="article-nav">
    <a href="/">← Kembali ke daftar</a>
    <a href="/articles">Lihat semua catatan →</a>
  </div>

  <script>
    // Copy-to-clipboard for code blocks
    document.querySelectorAll('.article-body pre').forEach(function(pre) {
      var wrap = document.createElement('div');
      wrap.className = 'code-block-wrap';
      pre.parentNode?.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      var btn = document.createElement('button');
      btn.className = 'code-copy-btn';
      btn.type = 'button';
      btn.setAttribute('aria-label', 'Salin kode');
      btn.textContent = 'copy';
      btn.addEventListener('click', function() {
        var code = pre.querySelector('code');
        var text = code ? code.textContent : pre.textContent;
        navigator.clipboard.writeText(text || '').then(function() {
          btn.textContent = 'copied!';
          setTimeout(function() { btn.textContent = 'copy'; }, 2000);
        });
      });
      wrap.appendChild(btn);
    });
  </script>
</BaseLayout>
