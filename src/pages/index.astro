---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { relativeTime } from '../utils/relativeTime';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<BaseLayout title="CryptoSynth — Catatan Crypto Personal" description="Catatan crypto pribadi. Node logs, airdrop farming, tutorial, dan opini DeFi.">
  <!-- Hero -->
  <section class="hero-v3">
    <div class="container">
      <div class="hero-v3-label">✦ Hanya catatan</div>
      <h1>Catatan Crypto Personal</h1>
      <p class="hero-v3-subtitle">Node logs, airdrop farming, trading, dan opini crypto dari sudut pandang pribadi.</p>
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- Articles -->
  <section class="section-articles">
    <div class="container">
      <div class="section-header-v3">
        <h2>Semua Catatan</h2>
        <a href="/articles">Lihat Semua →</a>
      </div>

      <div class="article-rows" id="articlesGrid">
        {posts.map((post, index) => (
          <article class:list={['article-row', index >= 9 && 'article-row-hidden']}>
            <div class="article-row-left">
              <div class="article-row-tags">
                {(post.data.tags || []).slice(0, 2).map((tag) => (
                  <span class="article-row-tag">#{tag}</span>
                ))}
              </div>
              <h3 class="article-row-title">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p class="article-row-excerpt">{post.data.excerpt || post.data.description}</p>
            </div>
            <div class="article-row-right">
              <span class="article-row-time" data-live-time data-pubdate={new Date(post.data.pubDate).toISOString()}>{relativeTime(post.data.pubDate)}</span>
              <span class="article-row-date">{new Date(post.data.pubDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Jakarta' })}</span>
            </div>
          </article>
        ))}
      </div>

      <div class="load-more" id="loadMoreWrap" style={posts.length <= 9 ? 'display:none' : ''}>
        <button type="button" class="load-more-btn" id="loadMoreBtn">
          Muat Lagi ↓
        </button>
        <p class="load-more-count" id="loadMoreCount">Menampilkan 9 dari {posts.length} catatan</p>
      </div>

      {posts.length === 0 && (
        <div style="text-align: center; padding: 4rem 0; color: var(--text-muted);">
          <p style="font-size: 1.05rem; margin-bottom: 0.5rem;">Catatan pertama akan segera hadir</p>
          <p style="font-size: 0.85rem;">Saya sedang menyiapkan konten terbaik untuk kamu.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== HERO V3 — Brutalist Premium ===== */
  .hero-v3 {
    padding: 0.5rem 0 2rem;
  }

  .hero-v3-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .hero-v3 h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    line-height: 1.0;
    letter-spacing: -0.04em;
    margin-bottom: 0.75rem;
    max-width: 600px;
    color: var(--text-primary);
  }

  .hero-v3-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 420px;
    line-height: 1.65;
    font-weight: 400;
  }

  /* ===== SECTION DIVIDER ===== */
  .section-divider {
    height: 1px;
    background: var(--border);
  }

  /* ===== SECTION HEADER V3 ===== */
  .section-header-v3 {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 2rem 0 1.25rem;
  }

  .section-header-v3 h2 {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .section-header-v3 a {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .section-header-v3 a:hover {
    color: var(--primary);
  }

  /* ===== ARTICLE ROWS — Brutalist Premium ===== */
  .article-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: start;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border-light);
    cursor: pointer;
    transition: all 0.25s ease;
    text-decoration: none;
    color: inherit;
  }

  .article-row:first-child {
    padding-top: 0;
  }

  .article-row:hover {
    padding-left: 0.75rem;
  }

  .article-row:hover .article-row-title a {
    color: var(--primary);
  }

  .article-row-left {
    min-width: 0;
  }

  .article-row-tags {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .article-row-tag {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .article-row-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 0.4rem;
    letter-spacing: -0.01em;
  }

  .article-row-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .article-row-excerpt {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-row-right {
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
    padding-top: 0.15rem;
    text-align: right;
  }

  .article-row-time {
    display: block;
  }

  .article-row-date {
    display: block;
    margin-top: 0.15rem;
  }

  /* Hidden rows (load-more) */
  .article-row-hidden {
    display: none;
  }

  /* ===== LOAD MORE ===== */
  .load-more {
    padding: 2rem 0;
    text-align: center;
  }

  .load-more-btn {
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-muted);
    background: none;
    border: 1px solid var(--border);
    padding: 0.65rem 2rem;
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 0.03em;
  }

  .load-more-btn:hover {
    color: var(--text-primary);
    border-color: var(--text-muted);
  }

  .load-more-count {
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-top: 0.75rem;
  }

  /* ===== ANIMATIONS ===== */
  @media (prefers-reduced-motion: no-preference) {
    .article-row {
      animation: fadeUp 0.4s ease both;
    }
    .article-row:nth-child(1) { animation-delay: 0.05s; }
    .article-row:nth-child(2) { animation-delay: 0.1s; }
    .article-row:nth-child(3) { animation-delay: 0.15s; }
    .article-row:nth-child(4) { animation-delay: 0.2s; }
    .article-row:nth-child(5) { animation-delay: 0.25s; }
    .article-row:nth-child(6) { animation-delay: 0.3s; }
    .article-row:nth-child(7) { animation-delay: 0.35s; }
    .article-row:nth-child(8) { animation-delay: 0.4s; }
    .article-row:nth-child(9) { animation-delay: 0.45s; }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .hero-v3 {
      padding: 0 0 1rem;
    }
    .hero-v3 h1 {
      font-size: 2rem;
    }
    .hero-v3-subtitle {
      font-size: 0.92rem;
    }
    .article-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .article-row-right {
      text-align: left;
      padding-top: 0;
    }
  }

  @media (max-width: 480px) {
    .hero-v3 h1 {
      font-size: 1.75rem;
    }
  }
</style>

<script>
  // Load more functionality
  const btn = document.getElementById('loadMoreBtn');
  const grid = document.getElementById('articlesGrid');
  const count = document.getElementById('loadMoreCount');
  const wrap = document.getElementById('loadMoreWrap');

  if (btn && grid) {
    const hidden = grid.querySelectorAll('.article-row-hidden');
    const total = grid.querySelectorAll('.article-row').length;
    let shown = total - hidden.length;

    btn.addEventListener('click', () => {
      const batch = Array.from(hidden).slice(0, 6);
      batch.forEach(el => el.classList.remove('article-row-hidden'));
      shown += batch.length;
      if (count) count.textContent = `Menampilkan ${shown} dari ${total} catatan`;
      if (shown >= total && wrap) wrap.style.display = 'none';
    });
  }

  // Live relative time updates
  (function() {
    function relativeTime(d) {
      var diffMs = Date.now() - d.getTime();
      if (diffMs < 0) return 'Baru saja';
      var sec = Math.floor(diffMs / 1000);
      var min = Math.floor(sec / 60);
      var hour = Math.floor(min / 60);
      var day = Math.floor(hour / 24);
      var week = Math.floor(day / 7);
      var month = Math.floor(day / 30);
      if (min < 1) return 'Baru saja';
      if (min < 60) return min + ' menit lalu';
      if (hour < 24) return hour + ' jam lalu';
      if (day < 7) return day + ' hari lalu';
      if (week < 4) return week + ' minggu lalu';
      if (month < 12) return month + ' bulan lalu';
      return d.toLocaleDateString('id-ID', { year:'numeric', month:'long', day:'numeric', timeZone:'Asia/Jakarta' });
    }
    function updateTimes() {
      var els = document.querySelectorAll('[data-live-time]');
      for (var i = 0; i < els.length; i++) {
        var iso = els[i].getAttribute('data-pubdate');
        if (!iso) continue;
        els[i].textContent = relativeTime(new Date(iso));
      }
    }
    updateTimes();
    setInterval(updateTimes, 60000);
  })();
</script>
